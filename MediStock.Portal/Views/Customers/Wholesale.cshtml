@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-building"></i> Wholesale Customers <small>B2B Accounts</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("Wholesale", "Customers")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
        </div>
        <h4 class="panel-title">Wholesale Customers</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-12">
                <button class="btn btn-sm btn-success" data-toggle="modal" data-target="#wholesaleModal" onclick="resetForm();">
                    <i class="fa fa-plus"></i> Add Wholesale Customer
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="wholesaleTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Business Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Credit Limit</th>
                            <th>Outstanding Balance</th>
                            <th>Payment Terms</th>
                            <th>Status</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="wholesaleModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form id="wholesaleForm">
                <input type="hidden" id="customerId" value="" />
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title" id="modalLabel"><i class="fa fa-building"></i> Add Wholesale Customer</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Business Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="customerName" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Phone</label>
                                <input type="text" class="form-control" id="phone" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" class="form-control" id="email" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Payment Terms</label>
                                <select class="form-control" id="paymentTerms">
                                    <option value="Cash">Cash</option>
                                    <option value="Net 30">Net 30</option>
                                    <option value="Credit">Credit</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Credit Limit (KES)</label>
                                <input type="number" class="form-control" id="creditLimit" step="0.01" min="0" value="0" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Address</label>
                                <input type="text" class="form-control" id="address" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label><input type="checkbox" id="isActive" checked /> Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                    <button type="button" class="btn btn-success" id="btnSaveCustomer"><i class="fa fa-save"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        // ============================================================
        //  Wholesale Customers — (Riziki BFF pattern)
        // ============================================================
        var table;

        $(document).ready(function () {
            table = initTable();
            loadWholesale();

            $('#wholesaleModal').on('hidden.bs.modal', function () {
                resetForm();
            });
        });

        function initTable() {
            return $('#wholesaleTable').dataTable({
                responsive: true,
                createdRow: function (row, data) { $(row).attr('recid', data.id); },
                aoColumns: [
                    { data: null, autoWidth: true, render: function (d) { return (d.first_name || '') + ' ' + (d.last_name || ''); } },
                    { data: 'phone', autoWidth: true, sDefaultContent: '-' },
                    { data: 'email', autoWidth: true, sDefaultContent: '-' },
                    { data: 'credit_limit', autoWidth: true, sDefaultContent: '0.00', render: function (d) { return 'KES ' + parseFloat(d || 0).toFixed(2); } },
                    { data: 'outstanding_balance', autoWidth: true, sDefaultContent: '0.00', render: function (d) {
                        var v = parseFloat(d || 0);
                        return v > 0 ? '<span class="text-danger"><strong>KES ' + v.toFixed(2) + '</strong></span>' : '<span class="text-success">KES 0.00</span>';
                    } },
                    { data: 'payment_terms', autoWidth: true, sDefaultContent: 'Cash' },
                    { data: 'is_active', autoWidth: true, sDefaultContent: 'Active', render: function (d) { return (d == 1 || d === true) ? '<span class="label label-success">Active</span>' : '<span class="label label-default">Inactive</span>'; } },
                    { bSortable: false, sDefaultContent: '<button class="btn btn-warning btn-xs edit-cus"><i class="fa fa-edit"></i></button>' },
                    { bSortable: false, sDefaultContent: '<button class="btn btn-danger btn-xs delete-cus"><i class="fa fa-trash"></i></button>' }
                ]
            });
        }

        function loadWholesale() {
            ajaxGet('/Customers/GetCustomers?type=Wholesale', function (data) {
                var filtered = (data || []).filter(function (c) { return c.customer_type === 'Wholesale'; });
                var s = table.fnSettings();
                table.fnClearTable(true);
                for (var i = 0; i < filtered.length; i++) table.oApi._fnAddData(s, filtered[i]);
                s.aiDisplay = s.aiDisplayMaster.slice();
                table.fnDraw();
            });
        }

        function resetForm() {
            $('#wholesaleForm')[0].reset();
            $('#customerId').val('');
            $('#isActive').prop('checked', true);
            $('#paymentTerms').val('Net 30');
            $('#creditLimit').val('0');
            $('#modalLabel').html('<i class="fa fa-building"></i> Add Wholesale Customer');
        }

        function getCustomerForm() {
            return {
                customer_name: $('#customerName').val().trim(),
                customer_type: 'Wholesale',
                phone: $('#phone').val().trim() || null,
                email: $('#email').val().trim() || null,
                address: $('#address').val().trim() || null,
                payment_terms: $('#paymentTerms').val(),
                credit_limit: parseFloat($('#creditLimit').val()) || 0,
                is_active: $('#isActive').is(':checked')
            };
        }

        // ── Edit ─────────────────────────────────────────────────────────────
        $('#wholesaleTable').on('click', 'button.edit-cus', function (e) {
            e.preventDefault();
            var d = table.fnGetData($(this).parents('tr')[0]);
            $('#customerId').val(d.id);
            $('#customerName').val(((d.first_name || '') + ' ' + (d.last_name || '')).trim());
            $('#phone').val(d.phone || '');
            $('#email').val(d.email || '');
            $('#address').val(d.address || '');
            $('#paymentTerms').val(d.payment_terms || 'Net 30');
            $('#creditLimit').val(d.credit_limit || 0);
            $('#isActive').prop('checked', !(d.is_active == 0 || d.is_active === false));
            $('#modalLabel').html('<i class="fa fa-edit"></i> Edit Wholesale Customer');
            $('#wholesaleModal').modal('show');
        });

        // ── Delete ───────────────────────────────────────────────────────────
        $('#wholesaleTable').on('click', 'button.delete-cus', function (e) {
            e.preventDefault();
            var d = table.fnGetData($(this).parents('tr')[0]);
            var name = (d.first_name || '') + ' ' + (d.last_name || '');
            Swal.fire({
                title: 'Delete Customer?',
                text: 'Delete "' + name.trim() + '"? This cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, Delete',
                reverseButtons: true
            }).then(function (r) {
                if (!r.isConfirmed) return;
                ajaxPost('/Customers/DeleteCustomer', { id: d.id }, function (res) {
                    if (res.success) {
                        loadWholesale();
                        Swal.fire('Deleted', res.message, 'success');
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                });
            });
        });

        // ── Save (add / update) ──────────────────────────────────────────────
        $('#btnSaveCustomer').on('click', function (e) {
            e.preventDefault();
            var name = $('#customerName').val().trim();
            if (!name) { Swal.fire('Validation', 'Customer name is required.', 'warning'); return; }
            var id = parseInt($('#customerId').val()) || 0;
            var url = id ? '/Customers/UpdateCustomer' : '/Customers/AddCustomer';
            var payload = getCustomerForm();
            if (id) payload.id = id;
            var btn = this;
            btnLoad(btn, 'Saving...');
            ajaxPost(url, payload, function (res) {
                btnStop(btn);
                if (res.success) {
                    $('#wholesaleModal').modal('hide');
                    loadWholesale();
                    Swal.fire(id ? 'Updated' : 'Saved', res.message, 'success');
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            }, function () { btnStop(btn); Swal.fire('Error', 'Request failed.', 'error'); });
        });
    </script>
}
