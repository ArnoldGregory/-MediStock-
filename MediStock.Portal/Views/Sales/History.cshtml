@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-history"></i> Sales History <small>Transactions</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("History", "Sales")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
        </div>
        <h4 class="panel-title">Sales Transactions</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-3">
                <label>From</label>
                <input type="text" class="form-control input-sm date-picker" id="dateFrom" placeholder="dd M yyyy" />
            </div>
            <div class="col-md-3">
                <label>To</label>
                <input type="text" class="form-control input-sm date-picker" id="dateTo" placeholder="dd M yyyy" />
            </div>
            <div class="col-md-3">
                <label>&nbsp;</label>
                <div>
                    <button class="btn btn-sm btn-primary" onclick="filterSales();"><i class="fa fa-filter"></i> Filter</button>
                    <button class="btn btn-sm btn-default" onclick="resetFilter();"><i class="fa fa-times"></i> Clear</button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="salesTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Receipt #</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Subtotal</th>
                            <th>Discount</th>
                            <th>Total</th>
                            <th>Payment</th>
                            <th>Sold By</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script>
        var table;
        $(document).ready(function () {
            $('.date-picker').datepicker({ autoclose: true, todayHighlight: true, format: 'dd M yyyy' });
            loadSales();
        });

        function loadSales(from, to) {
            if (table) table.destroy();
            var url = '/api/sales?';
            if (from) url += 'from=' + encodeURIComponent(from) + '&';
            if (to) url += 'to=' + encodeURIComponent(to);

            table = $('#salesTable').DataTable({
                ajax: { url: url, dataSrc: '' },
                columns: [
                    { data: 'receiptNumber' },
                    { data: 'saleDate', render: function (d) { return formatDate(d); } },
                    { data: 'customerName', defaultContent: 'Walk-In' },
                    { data: 'totalItems' },
                    { data: 'subtotal', render: function (d) { return 'KES ' + parseFloat(d).toFixed(2); } },
                    { data: 'discount', render: function (d) { return parseFloat(d).toFixed(2); } },
                    { data: 'totalAmount', render: function (d) { return '<strong>KES ' + parseFloat(d).toFixed(2) + '</strong>'; } },
                    { data: 'paymentMethod', render: function (d) {
                        var cls = d === 'Cash' ? 'label-success' : d === 'Mpesa' ? 'label-info' : d === 'Credit' ? 'label-warning' : 'label-default';
                        return '<span class="label ' + cls + '">' + d + '</span>';
                    }},
                    { data: 'soldByName' },
                    { data: null, orderable: false, searchable: false, render: function (data) {
                        return '<a href="/Sales/Receipt/' + data.saleId + '" class="btn btn-xs btn-info"><i class="fa fa-print"></i></a>';
                    }}
                ],
                order: [[1, 'desc']]
            });
        }

        function filterSales() {
            var from = $('#dateFrom').val();
            var to = $('#dateTo').val();
            loadSales(from, to);
        }

        function resetFilter() {
            $('#dateFrom').val('');
            $('#dateTo').val('');
            loadSales();
        }

        function formatDate(d) {
            if (!d) return '-';
            return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        }
    </script>
}
