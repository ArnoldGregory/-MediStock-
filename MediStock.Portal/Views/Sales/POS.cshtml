@section PageStyles {
    <link href="~/assets/static/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <style>
        .pos-container { display: flex; gap: 15px; min-height: 500px; }
        .pos-products { flex: 1; }
        .pos-cart { width: 380px; }
        .cart-table td { padding: 6px 8px; vertical-align: middle; }
        .cart-total { font-size: 18px; font-weight: bold; }
        .product-card { cursor: pointer; border: 1px solid #e5e5e5; border-radius: 4px; padding: 10px; margin-bottom: 10px; transition: all 0.2s; }
        .product-card:hover { border-color: #3498db; background: #f8f9fa; }
        .product-card .name { font-weight: bold; font-size: 13px; }
        .product-card .price { color: #28a745; font-weight: bold; }
        .product-card .stock { font-size: 11px; color: #999; }
    </style>
}

<div style="display:none;">@Html.AntiForgeryToken()</div>

<h1 class="page-header"><i class="fa fa-shopping-cart"></i> Point of Sale <small>Sales Terminal</small></h1>

<div class="pos-container">
    <!-- Left: Product Search & Grid -->
    <div class="pos-products">
        <div class="panel panel-inverse">
            <div class="panel-heading">
                <h4 class="panel-title"><i class="fa fa-search"></i> Products</h4>
            </div>
            <div class="panel-body">
                <div class="form-group">
                    <div class="input-group">
                        <input type="text" class="form-control" id="productSearch" placeholder="Search product by name, code, or scan barcode..." autofocus />
                        <span class="input-group-addon"><i class="fa fa-search"></i></span>
                    </div>
                </div>
                <div id="productGrid" class="row" style="max-height:400px;overflow-y:auto;">
                    <div class="col-md-12 text-center text-muted">
                        <i class="fa fa-search fa-3x"></i>
                        <p>Search for a product to add to cart</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Cart -->
    <div class="pos-cart">
        <div class="panel panel-inverse">
            <div class="panel-heading">
                <h4 class="panel-title"><i class="fa fa-shopping-basket"></i> Cart</h4>
            </div>
            <div class="panel-body" style="padding:10px;">
                <div class="form-group">
                    <label class="checkbox-inline">
                        <input type="checkbox" id="dispenseToggle" />
                        <strong>Dispense Prescription (Rx)</strong>
                    </label>
                </div>

                <div id="dispenseFields" style="display:none;">
                    <div class="form-group">
                        <label>Patient</label>
                        <select class="form-control select2" id="dispensePatient" style="width:100%;">
                            <option value="">Select patient...</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Prescription</label>
                        <select class="form-control" id="dispensePrescription" style="width:100%;">
                            <option value="">Auto (create on save)</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>Customer</label>
                    <select class="form-control select2" id="posCustomer" style="width:100%;">
                        <option value="">Walk-In Customer</option>
                    </select>
                </div>

                <div style="max-height:250px;overflow-y:auto;">
                    <table class="table table-condensed cart-table" id="cartTable">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th style="width:60px;">Qty</th>
                                <th style="width:80px;">Price</th>
                                <th style="width:80px;">Total</th>
                                <th style="width:30px;"></th>
                            </tr>
                        </thead>
                        <tbody id="cartBody">
                            <tr><td colspan="5" class="text-center text-muted">Cart is empty</td></tr>
                        </tbody>
                    </table>
                </div>

                <hr style="margin:8px 0;" />
                <div class="row">
                    <div class="col-xs-6"><strong>Subtotal:</strong></div>
                    <div class="col-xs-6 text-right cart-total" id="cartSubtotal">KES 0.00</div>
                </div>
                <div class="row">
                    <div class="col-xs-6"><strong>Discount:</strong></div>
                    <div class="col-xs-6">
                        <input type="number" class="form-control input-sm" id="cartDiscount" value="0" min="0" style="text-align:right;" />
                    </div>
                </div>
                <hr style="margin:8px 0;" />
                <div class="row">
                    <div class="col-xs-6"><strong style="font-size:18px;">TOTAL:</strong></div>
                    <div class="col-xs-6 text-right cart-total" id="cartTotal" style="color:#28a745;">KES 0.00</div>
                </div>

                <div class="form-group m-t-10">
                    <label>Payment Method</label>
                    <select class="form-control" id="paymentMethod">
                        <option value="Cash">Cash</option>
                        <option value="Mpesa">M-Pesa</option>
                        <option value="Card">Debit/Credit Card</option>
                        <option value="Credit">Store Credit</option>
                    </select>
                </div>
                <div class="form-group" id="mpesaRefGroup" style="display:none;">
                    <label>M-Pesa Reference</label>
                    <input type="text" class="form-control" id="mpesaRef" placeholder="M-Pesa transaction code" />
                </div>

                <button class="btn btn-success btn-block btn-lg" id="processSaleBtn" disabled>
                    <i class="fa fa-check"></i> Process Sale
                </button>
                <button class="btn btn-default btn-block btn-sm m-t-5" id="clearCartBtn">
                    <i class="fa fa-trash"></i> Clear Cart
                </button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/select2/dist/js/select2.full.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        var cart = [];
        var products = [];

        $(document).ready(function () {
            $('.select2').select2({ width: '100%' });
            loadProducts();
            loadCustomers();
            loadPatients();
            $('#paymentMethod').on('change', function () {
                $('#mpesaRefGroup').toggle($(this).val() === 'Mpesa');
            });
            $('#dispenseToggle').on('change', function () {
                $('#dispenseFields').toggle($(this).is(':checked'));
            });
            $('#dispensePatient').on('change', function () {
                loadPrescriptions($(this).val());
            });

            $('#productSearch').on('keyup', function () {
                renderProductGrid(searchProducts($(this).val().trim()));
            });

            $('#productSearch').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    renderProductGrid(searchProducts($(this).val().trim()));
                }
            });

            $('#clearCartBtn').on('click', clearCart);
            $('#processSaleBtn').on('click', processSale);
        });

        function loadProducts() {
            var $grid = $('#productGrid');
            $grid.html('<div class="col-md-12 text-center text-muted"><i class="fa fa-spinner fa-spin fa-3x"></i><p>Loading products...</p></div>');
            ajaxGet('/Sales/GetPOSProducts', function (data) {
                products = data || [];
                renderProductGrid(products);
            }, function () {
                $grid.html('<div class="col-md-12 text-center text-muted"><p>Failed to load products.</p></div>');
            });
        }

        function searchProducts(query) {
            q = (query || '').toLowerCase();
            if (!q) return products;
            return products.filter(function (p) {
                return (p.name && p.name.toLowerCase().indexOf(q) >= 0)
                    || (p.sku && p.sku.toLowerCase().indexOf(q) >= 0)
                    || (p.barcode && p.barcode.toLowerCase().indexOf(q) >= 0);
            });
        }

        function renderProductGrid(items) {
            var html = '';
            if (!items || items.length === 0) {
                html = '<div class="col-md-12 text-center text-muted"><p>No products found</p></div>';
            } else {
                $.each(items, function (i, p) {
                    html += '<div class="col-md-4 col-sm-6"><div class="product-card" onclick="addToCart(' + p.id + ')">';
                    html += '<div class="name">' + p.name + '</div>';
                    html += '<div class="price">KES ' + parseFloat(p.selling_price || 0).toFixed(2) + '</div>';
                    html += '<div class="stock">Stock: ' + (p.stock_qty || 0) + '</div>';
                    html += '</div></div>';
                });
            }
            $('#productGrid').html(html);
        }

        function addToCart(productId) {
            var product = null;
            for (var i = 0; i < products.length; i++) if (products[i].id == productId) { product = products[i]; break; }
            if (!product) return;

            var maxStock = parseInt(product.stock_qty) || 0;
            if (maxStock <= 0) {
                Swal.fire('Out of Stock', product.name + ' is out of stock.', 'warning');
                return;
            }

            var existing = null;
            for (var j = 0; j < cart.length; j++) if (cart[j].productId == productId) { existing = cart[j]; break; }
            if (existing) {
                if (existing.quantity >= maxStock) {
                    Swal.fire('Insufficient Stock', 'Only ' + maxStock + ' units available.', 'warning');
                    return;
                }
                existing.quantity++;
            } else {
                cart.push({
                    productId: product.id,
                    productName: product.name,
                    sellingPrice: parseFloat(product.selling_price || 0),
                    quantity: 1,
                    maxStock: maxStock
                });
            }
            renderCart();
        }

        function renderCart() {
            var html = '';
            var subtotal = 0;

            if (cart.length === 0) {
                html = '<tr><td colspan="5" class="text-center text-muted">Cart is empty</td></tr>';
            } else {
                $.each(cart, function (i, item) {
                    var total = item.sellingPrice * item.quantity;
                    subtotal += total;
                    html += '<tr>';
                    html += '<td>' + item.productName + '</td>';
                    html += '<td><input type="number" class="form-control input-sm" style="width:50px;" value="' + item.quantity + '" min="1" max="' + item.maxStock + '" onchange="updateQty(' + i + ', this.value)" /></td>';
                    html += '<td>' + parseFloat(item.sellingPrice).toFixed(2) + '</td>';
                    html += '<td>' + parseFloat(total).toFixed(2) + '</td>';
                    html += '<td><button class="btn btn-xs btn-danger" onclick="removeFromCart(' + i + ')"><i class="fa fa-times"></i></button></td>';
                    html += '</tr>';
                });
            }

            $('#cartBody').html(html);
            var discount = parseFloat($('#cartDiscount').val()) || 0;
            var total = subtotal - discount;
            $('#cartSubtotal').text('KES ' + subtotal.toFixed(2));
            $('#cartTotal').text('KES ' + total.toFixed(2));
            $('#processSaleBtn').prop('disabled', cart.length === 0);
        }

        function updateQty(index, qty) {
            qty = parseInt(qty);
            if (qty <= 0) { removeFromCart(index); return; }
            if (qty > cart[index].maxStock) {
                Swal.fire('Insufficient Stock', 'Only ' + cart[index].maxStock + ' units available.', 'warning');
                qty = cart[index].maxStock;
            }
            cart[index].quantity = qty;
            renderCart();
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            renderCart();
        }

        function clearCart() {
            cart = [];
            renderCart();
        }

        function loadCustomers() {
            ajaxGet('/Sales/GetCustomers', function (data) {
                var $sel = $('#posCustomer');
                data = data || [];
                $.each(data, function (i, c) {
                    var name = (c.first_name || '') + ' ' + (c.last_name || '');
                    $sel.append('<option value="' + c.id + '">' + name.trim() + (c.customer_type ? ' (' + c.customer_type + ')' : '') + '</option>');
                });
            });
        }

        function loadPatients() {
            ajaxGet('/Sales/GetPatients', function (data) {
                var $sel = $('#dispensePatient');
                data = data || [];
                $.each(data, function (i, p) {
                    var name = (p.first_name || '') + ' ' + (p.last_name || '');
                    $sel.append('<option value="' + p.id + '">' + name.trim() + (p.phone ? ' (' + p.phone + ')' : '') + '</option>');
                });
            });
        }

        function loadPrescriptions(patientId) {
            var $sel = $('#dispensePrescription');
            $sel.empty().append('<option value="">Auto (create on save)</option>');
            if (!patientId) return;
            $.ajax({
                url: '/Sales/GetPrescriptions?patientId=' + patientId,
                type: 'GET'
            }).done(function (res) {
                var list = (res && res.data) ? res.data : (res || []);
                if (Array.isArray(list)) {
                    $.each(list, function (i, r) {
                        var num = r.prescription_number || '';
                        $sel.append('<option value="' + r.id + '">' + (num || ('# ' + r.id)) + '</option>');
                    });
                }
            });
        }

        function processSale() {
            if (cart.length === 0) return;

            var subtotal = 0;
            var items = cart.map(function (c) {
                var total = c.sellingPrice * c.quantity;
                subtotal += total;
                return {
                    product_id: c.productId,
                    quantity: c.quantity,
                    unit_price: c.sellingPrice,
                    discount: 0,
                    total: parseFloat(total.toFixed(2)),
                    batch_id: null
                };
            });

            var discount = parseFloat($('#cartDiscount').val()) || 0;
            var total = subtotal - discount;
            var method = $('#paymentMethod').val();
            var dispense = $('#dispenseToggle').is(':checked');
            var prescriptionId = dispense ? (parseInt($('#dispensePrescription').val()) || null) : null;
            var payload = {
                customer_id: $('#posCustomer').val() ? parseInt($('#posCustomer').val()) : null,
                sale_type: 'Retail',
                sale_mode: dispense ? 'DISPENSE' : 'POS',
                prescription_id: prescriptionId,
                dispensed_by: null,
                subtotal: parseFloat(subtotal.toFixed(2)),
                discount: parseFloat(discount.toFixed(2)),
                tax: 0,
                net_amount: parseFloat(total.toFixed(2)),
                amount_paid: method === 'Credit' ? 0 : parseFloat(total.toFixed(2)),
                payment_method: method,
                payment_reference: method === 'Mpesa' ? ($('#mpesaRef').val() || null) : null,
                notes: dispense && prescriptionId == null ? 'Rx dispense (new prescription)' : null,
                items: items
            };

            Swal.fire({
                title: 'Confirm Sale',
                html: '<strong>Total: KES ' + $('#cartTotal').text().replace('KES ', '') + '</strong>',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                confirmButtonText: 'Confirm & Pay'
            }).then(function (result) {
                if (!result.isConfirmed) return;
                var btn = $('#processSaleBtn')[0];
                btnLoad(btn, 'Processing...');
                ajaxPost('/Sales/ProcessSale', payload, function (res) {
                    btnStop(btn);
                    if (res.success) {
                        var saleId = res.data ? res.data.id : 0;
                        Swal.fire({
                            title: 'Sale Complete!',
                            html: 'Receipt #: <strong>' + saleId + '</strong><br/><a href="/Sales/Receipt/' + saleId + '" class="btn btn-sm btn-info m-t-10"><i class="fa fa-print"></i> Print Receipt</a>',
                            icon: 'success',
                            confirmButtonText: 'OK'
                        });
                        clearCart();
                        $('#productSearch').val('').focus();
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                }, function () {
                    btnStop(btn);
                    Swal.fire('Error', 'Unable to process sale.', 'error');
                });
            });
        }

        $('#cartDiscount').on('change', renderCart);
    </script>
}
