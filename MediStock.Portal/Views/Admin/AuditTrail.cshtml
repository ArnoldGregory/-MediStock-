@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-datepicker/css/bootstrap-datepicker.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-history"></i> Audit Trail <small>System Activity Log</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("AuditTrail", "Admin")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
        </div>
        <h4 class="panel-title">Audit Log</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-3">
                <label>From</label>
                <input type="text" class="form-control date-picker" id="dateFrom" placeholder="dd M yyyy" />
            </div>
            <div class="col-md-3">
                <label>To</label>
                <input type="text" class="form-control date-picker" id="dateTo" placeholder="dd M yyyy" />
            </div>
            <div class="col-md-3" style="padding-top:25px;">
                <button class="btn btn-primary" onclick="loadAudit();"><i class="fa fa-filter"></i> Filter</button>
                <button class="btn btn-default" onclick="clearFilters();"><i class="fa fa-times"></i> Clear</button>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="auditTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Description</th>
                            <th>Page</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
    <script>
        var auditTable;

        $(document).ready(function () {
            $('.date-picker').datepicker({ autoclose: true, todayHighlight: true, format: 'dd M yyyy' });
            loadAudit();
        });

        function loadAudit() {
            if (auditTable) auditTable.destroy();

            auditTable = $('#auditTable').DataTable({
                ajax: {
                    url: '/Admin/GetAuditData?pageSize=200',
                    dataSrc: function (json) {
                        return json.data || json;
                    }
                },
                columns: [
                    {
                        data: 'created_on',
                        render: function (d) {
                            return d ? formatDateTime(d) : '-';
                        }
                    },
                    { data: 'user_name', defaultContent: '-' },
                    { data: 'action_type', defaultContent: '-' },
                    { data: 'action_description', defaultContent: '-' },
                    {
                        data: 'page_accessed',
                        render: function (d) {
                            if (!d) return '-';
                            var parts = d.split('/');
                            return '<small>' + (parts[parts.length - 1] || d) + '</small>';
                        }
                    },
                    { data: 'client_ip_address', defaultContent: '-' }
                ],
                order: [[0, 'desc']],
                pageLength: 25,
                language: {
                    search: '_INPUT_',
                    searchPlaceholder: 'Search audit log...',
                    emptyTable: 'No audit records found'
                }
            });
        }

        function clearFilters() {
            $('#dateFrom').val('');
            $('#dateTo').val('');
            loadAudit();
        }

        function formatDateTime(d) {
            return new Date(d).toLocaleString('en-GB', {
                day: '2-digit', month: 'short', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            });
        }
    </script>
}
