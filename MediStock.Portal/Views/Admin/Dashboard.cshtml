@{
    ViewData["Title"] = "Admin Dashboard";
    ViewBag.MenuLayout = "Side";
}

<h1 class="page-header"><i class="fa fa-cogs"></i> Admin Dashboard <small>System Administration</small></h1>

<!-- Stat Cards -->
<div class="row">
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-green">
            <div class="stats-icon"><i class="fa fa-users"></i></div>
            <div class="stats-info"><h4>USERS</h4><p id="statUsers"><i class="fa fa-spinner fa-spin"></i></p></div>
            <div class="stats-link"><a href="/Admin/Users">Manage <i class="fa fa-arrow-alt-circle-right"></i></a></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-blue">
            <div class="stats-icon"><i class="fa fa-hospital-o"></i></div>
            <div class="stats-info"><h4>PHARMACY</h4><p id="statPharmacy"><i class="fa fa-spinner fa-spin"></i></p></div>
            <div class="stats-link"><a href="/Settings/Pharmacy">Configure <i class="fa fa-arrow-alt-circle-right"></i></a></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-orange">
            <div class="stats-icon"><i class="fa fa-pills"></i></div>
            <div class="stats-info"><h4>PRODUCTS</h4><p id="statProducts"><i class="fa fa-spinner fa-spin"></i></p></div>
            <div class="stats-link"><a href="/Products/Index">View <i class="fa fa-arrow-alt-circle-right"></i></a></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-purple">
            <div class="stats-icon"><i class="fa fa-exclamation-triangle"></i></div>
            <div class="stats-info"><h4>ALERTS</h4><p id="statAlerts"><i class="fa fa-spinner fa-spin"></i></p></div>
            <div class="stats-link"><a href="/Stock/Batches">View <i class="fa fa-arrow-alt-circle-right"></i></a></div>
        </div>
    </div>
</div>

<!-- Quick Links + System Info -->
<div class="row m-t-20">
    <div class="col-md-6">
        <div class="panel panel-inverse">
            <div class="panel-heading"><h4 class="panel-title" style="color:#fff;"><i class="fa fa-bolt m-r-5"></i> Quick Actions</h4></div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6">
                        <a href="/Admin/Users" class="btn btn-primary btn-block m-b-10"><i class="fa fa-users"></i> Manage Users</a>
                        <a href="/Settings/Pharmacy" class="btn btn-info btn-block m-b-10"><i class="fa fa-hospital-o"></i> Pharmacy Settings</a>
                        <a href="/Products/Categories" class="btn btn-success btn-block m-b-10"><i class="fa fa-tags"></i> Manage Categories</a>
                    </div>
                    <div class="col-md-6">
                        <a href="/Reports/Sales" class="btn btn-warning btn-block m-b-10"><i class="fa fa-bar-chart"></i> Sales Reports</a>
                        <a href="/Reports/Financial" class="btn btn-danger btn-block m-b-10"><i class="fa fa-line-chart"></i> Financial Reports</a>
                        <a href="/DDA/Report" class="btn btn-purple btn-block m-b-10" style="background:#8e44ad;color:#fff;"><i class="fa fa-shield"></i> DDA Report</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-inverse">
            <div class="panel-heading"><h4 class="panel-title" style="color:#fff;"><i class="fa fa-info-circle m-r-5"></i> System Information</h4></div>
            <div class="panel-body" id="systemInfo"><i class="fa fa-spinner fa-spin"></i> Loading...</div>
        </div>
    </div>
</div>

<!-- Recent Users Activity -->
<div class="row m-t-20">
    <div class="col-md-12">
        <div class="panel panel-inverse">
            <div class="panel-heading"><h4 class="panel-title" style="color:#fff;"><i class="fa fa-clock-o m-r-5"></i> Recent User Logins</h4></div>
            <div class="panel-body" id="recentLogins"><i class="fa fa-spinner fa-spin"></i> Loading...</div>
        </div>
    </div>
</div>

@section PageScripts {
    <script>
        $(document).ready(function () {
            loadAdminStats();
        });

        function loadAdminStats() {
            $.get('/api/admin/stats', function (data) {
                $('#statUsers').text(data.totalUsers || 0);
                $('#statPharmacy').text(data.pharmacyName || '-');
                $('#statProducts').text(data.totalProducts || 0);
                $('#statAlerts').text(data.alertCount || 0);
            }).fail(function () {
                $('#statUsers').text('0');
                $('#statPharmacy').text('-');
                $('#statProducts').text('0');
                $('#statAlerts').text('0');
            });

            $.get('/api/admin/system-info', function (data) {
                var html = '<table class="table table-condensed">';
                html += '<tr><td><strong>Version</strong></td><td>' + (data.version || '-') + '</td></tr>';
                html += '<tr><td><strong>Database</strong></td><td>' + (data.databaseStatus || '-') + '</td></tr>';
                html += '<tr><td><strong>Server Time</strong></td><td>' + (data.serverTime || '-') + '</td></tr>';
                html += '</table>';
                $('#systemInfo').html(html);
            }).fail(function () {
                $('#systemInfo').html('<p class="text-muted">Unable to load system info</p>');
            });

            $.get('/api/admin/recent-logins', function (data) {
                var html = '<table class="table table-condensed table-striped"><thead><tr><th>User</th><th>Email</th><th>Role</th><th>Last Login</th></tr></thead><tbody>';
                if (data && data.length) {
                    $.each(data, function (i, u) {
                        html += '<tr><td>' + u.fullName + '</td><td>' + u.email + '</td><td>' + u.roleName + '</td><td>' + (u.lastLoginDate ? new Date(u.lastLoginDate).toLocaleString() : 'Never') + '</td></tr>';
                    });
                } else {
                    html += '<tr><td colspan="4" class="text-muted">No login data</td></tr>';
                }
                html += '</tbody></table>';
                $('#recentLogins').html(html);
            }).fail(function () {
                $('#recentLogins').html('<p class="text-muted">Unable to load data</p>');
            });
        }
    </script>
}
