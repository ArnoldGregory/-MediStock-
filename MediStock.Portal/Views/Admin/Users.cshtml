@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-users"></i> User Management <small>Administration</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("Users", "Admin")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
        </div>
        <h4 class="panel-title">Users</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-12">
                <button class="btn btn-sm btn-success" data-toggle="modal" data-target="#userModal" onclick="resetForm();">
                    <i class="fa fa-plus"></i> Add User
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="usersTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Phone</th>
                            <th>Last Login</th>
                            <th>Status</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit User Modal -->
<div class="modal fade" id="userModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="userForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="userId" value="" />
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title" id="modalLabel"><i class="fa fa-user-plus"></i> Add User</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>First Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="firstName" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Last Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="lastName" required />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="email" required />
                    </div>
                    <div class="form-group">
                        <label>Phone</label>
                        <input type="text" class="form-control" id="phone" />
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Role <span class="text-danger">*</span></label>
                                <select class="form-control select2" id="roleId" required>
                                    <option value="">-- Select --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Password</label>
                                <input type="password" class="form-control" id="password" placeholder="Leave blank to keep current" minlength="6" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                    <button type="submit" class="btn btn-success" id="btnSave"><i class="fa fa-save"></i> Save User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-red">
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                <h4 class="modal-title" style="color:#fff;"><i class="fa fa-trash"></i> Delete User</h4>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="deleteName"></strong>?</p>
                <p class="text-danger"><i class="fa fa-warning"></i> This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDelete"><i class="fa fa-trash"></i> Delete</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/assets/static/plugins/select2/dist/js/select2.full.min.js"></script>
    <script>
        var table;
        var rolesMap = {};

        $(document).ready(function () {
            $('.select2').select2({ width: '100%' });
            loadRoles();
            loadUsers();
        });

        function loadUsers() {
            table = $('#usersTable').DataTable({
                ajax: {
                    url: '/Admin/GetUsers',
                    dataSrc: function (json) {
                        return json.data || json;
                    }
                },
                columns: [
                    {
                        data: null,
                        render: function (d) {
                            return (d.first_name || d.firstName || '') + ' ' + (d.last_name || d.lastName || '');
                        }
                    },
                    { data: 'email' },
                    {
                        data: null,
                        render: function (d) {
                            var roleId = d.role_id || d.roleId || 0;
                            return rolesMap[roleId] || 'Role ' + roleId;
                        }
                    },
                    {
                        data: null,
                        render: function (d) {
                            return d.phone || d.mobile || '-';
                        }
                    },
                    {
                        data: null,
                        render: function (d) {
                            var dt = d.last_login_date || d.created_on || d.lastLoginDate;
                            return dt ? formatDate(dt) : 'Never';
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (d) {
                            var active = d === true || d === 1 || d === '1';
                            return active
                                ? '<span class="label label-success">Active</span>'
                                : '<span class="label label-default">Inactive</span>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (d) {
                            var id = d.id || d.userId;
                            return '<button class="btn btn-xs btn-primary" onclick="editUser(' + id + ')"><i class="fa fa-edit"></i></button>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (d) {
                            var id = d.id || d.userId;
                            var name = (d.first_name || d.firstName || '') + ' ' + (d.last_name || d.lastName || '');
                            return '<button class="btn btn-xs btn-danger" onclick="deleteUser(' + id + ',\'' + name.replace(/'/g, "\\'") + '\')"><i class="fa fa-trash"></i></button>';
                        }
                    }
                ],
                order: [[0, 'asc']]
            });
        }

        function loadRoles() {
            $.get('/Admin/GetRoles', function (res) {
                var data = res.data || res;
                var $sel = $('#roleId');
                $.each(data, function (i, r) {
                    var id = r.roleId || r.role_id || r.id;
                    var name = r.roleName || r.role_name || r.name;
                    rolesMap[id] = name;
                    $sel.append('<option value="' + id + '">' + name + '</option>');
                });
            });
        }

        function resetForm() {
            $('#userForm')[0].reset();
            $('#userId').val('');
            $('#modalLabel').html('<i class="fa fa-user-plus"></i> Add User');
            $('#password').attr('required', 'required');
            $('.select2').val(null).trigger('change');
        }

        function editUser(id) {
            $.get('/Admin/GetUser?id=' + id, function (res) {
                var data = res.data || res;
                $('#userId').val(data.id || data.userId);
                $('#firstName').val(data.first_name || data.firstName);
                $('#lastName').val(data.last_name || data.lastName);
                $('#email').val(data.email);
                $('#phone').val(data.phone || data.mobile);
                var roleId = data.role_id || data.roleId;
                $('#roleId').val(roleId).trigger('change');
                $('#password').removeAttr('required').attr('placeholder', 'Leave blank to keep current');
                $('#modalLabel').html('<i class="fa fa-edit"></i> Edit User');
                $('#userModal').modal('show');
            });
        }

        function deleteUser(id, name) {
            $('#deleteName').text(name);
            $('#confirmDelete').off('click').on('click', function () {
                $.ajax({
                    url: '/Admin/DeleteUser',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ id: id }),
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function () {
                        Swal.fire('Deleted', 'User deleted.', 'success');
                        table.ajax.reload();
                        $('#deleteModal').modal('hide');
                    },
                    error: function () {
                        Swal.fire('Error', 'Unable to delete.', 'error');
                    }
                });
            });
            $('#deleteModal').modal('show');
        }

        function formatDate(d) {
            return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        }

        $('#userForm').on('submit', function (e) {
            e.preventDefault();
            var id = $('#userId').val();
            var payload = id
                ? {
                    id: parseInt(id),
                    first_name: $('#firstName').val(),
                    last_name: $('#lastName').val(),
                    email: $('#email').val(),
                    phone: $('#phone').val(),
                    role_id: parseInt($('#roleId').val()) || 3,
                    is_active: true
                }
                : {
                    first_name: $('#firstName').val(),
                    last_name: $('#lastName').val(),
                    email: $('#email').val(),
                    phone: $('#phone').val(),
                    role_id: parseInt($('#roleId').val()) || 3,
                    password: $('#password').val() || 'password'
                };

            btnLoad('#btnSave', 'Saving...');

            $.ajax({
                url: id ? '/Admin/UpdateUser' : '/Admin/AddUser',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function () {
                    Swal.fire('Saved', 'User saved.', 'success');
                    $('#userModal').modal('hide');
                    table.ajax.reload();
                    btnStop('#btnSave');
                },
                error: function (xhr) {
                    Swal.fire('Error', xhr.responseText || 'Unable to save.', 'error');
                    btnStop('#btnSave');
                }
            });
        });
    </script>
}
