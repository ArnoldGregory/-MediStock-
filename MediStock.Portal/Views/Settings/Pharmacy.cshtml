@section PageStyles {
}

<h1 class="page-header"><i class="fa fa-hospital-o"></i> Pharmacy Settings <small>Configuration</small></h1>

<div class="row">
    <div class="col-md-8">
        <div class="panel panel-inverse">
            <div class="panel-heading">
                <h4 class="panel-title"><i class="fa fa-cog"></i> Pharmacy Information</h4>
            </div>
            <div class="panel-body">
                <form asp-controller="Settings" asp-action="UpdatePharmacy" method="POST" id="pharmacyForm">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Pharmacy Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="pharmacyName" name="pharmacyName" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Slug / Code</label>
                                <input type="text" class="form-control" id="slug" name="slug" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Phone</label>
                                <input type="text" class="form-control" id="pharmacyPhone" name="phone" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" class="form-control" id="pharmacyEmail" name="email" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Physical Address</label>
                        <textarea class="form-control" id="address" name="address" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>License Number</label>
                                <input type="text" class="form-control" id="licenseNumber" name="licenseNumber" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>License Expiry</label>
                                <input type="date" class="form-control" id="licenseExpiry" name="licenseExpiry" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>KRA PIN</label>
                                <input type="text" class="form-control" id="kraPin" name="kraPin" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Currency</label>
                                <select class="form-control" id="currency" name="currency">
                                    <option value="KES">KES — Kenyan Shilling</option>
                                    <option value="USD">USD — US Dollar</option>
                                    <option value="UGX">UGX — Ugandan Shilling</option>
                                    <option value="TZS">TZS — Tanzanian Shilling</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <hr />
                    <h4><i class="fa fa-sliders"></i> Operational Settings</h4>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Default Tax Rate (%)</label>
                                <input type="number" class="form-control" id="taxRate" name="taxRate" step="0.01" min="0" max="100" value="16" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Default Discount Limit (%)</label>
                                <input type="number" class="form-control" id="discountLimit" name="discountLimit" step="0.01" min="0" max="100" value="10" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Low Stock Alert Days</label>
                                <input type="number" class="form-control" id="lowStockDays" name="lowStockAlertDays" value="30" min="1" />
                            </div>
                        </div>
                    </div>

                    <div class="m-t-20">
                        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save Settings</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Sidebar: Status -->
    <div class="col-md-4">
        <div class="panel panel-inverse">
            <div class="panel-heading"><h4 class="panel-title" style="color:#fff;"><i class="fa fa-info-circle"></i> Status</h4></div>
            <div class="panel-body" id="pharmacyStatus"><i class="fa fa-spinner fa-spin"></i> Loading...</div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        $(document).ready(function () { loadPharmacySettings(); });

        function loadPharmacySettings() {
            $.get('/api/settings/pharmacy', function (data) {
                $('#pharmacyName').val(data.pharmacyName);
                $('#slug').val(data.slug);
                $('#pharmacyPhone').val(data.phone);
                $('#pharmacyEmail').val(data.email);
                $('#address').val(data.address);
                $('#licenseNumber').val(data.licenseNumber);
                $('#licenseExpiry').val(data.licenseExpiry ? data.licenseExpiry.split('T')[0] : '');
                $('#kraPin').val(data.kraPin);
                $('#currency').val(data.currency);
                $('#taxRate').val(data.taxRate);
                $('#discountLimit').val(data.discountLimit);
                $('#lowStockDays').val(data.lowStockAlertDays);

                var statusHtml = '<table class="table table-condensed">';
                statusHtml += '<tr><td><strong>Status</strong></td><td><span class="label label-success">Active</span></td></tr>';
                statusHtml += '<tr><td><strong>Slug</strong></td><td>' + data.slug + '</td></tr>';
                statusHtml += '<tr><td><strong>License</strong></td><td>' + (data.licenseNumber || '-') + '</td></tr>';
                statusHtml += '</table>';
                $('#pharmacyStatus').html(statusHtml);
            });
        }

        $('#pharmacyForm').on('submit', function (e) {
            e.preventDefault();
            $.ajax({
                url: '/api/settings/pharmacy',
                type: 'PUT',
                data: $(this).serialize(),
                success: function () { Swal.fire('Saved', 'Pharmacy settings updated.', 'success'); },
                error: function (xhr) { Swal.fire('Error', xhr.responseText || 'Unable to save.', 'error'); }
            });
        });
    </script>
}
