<h1 class="page-header"><i class="fa fa-user-circle"></i> My Profile <small>Account</small></h1>

<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="panel panel-inverse">
            <div class="panel-heading">
                <h4 class="panel-title"><i class="fa fa-user"></i> Profile Information</h4>
            </div>
            <div class="panel-body">
                <table class="table table-bordered">
                    <tr>
                        <th style="width:40%;">First Name</th>
                        <td>@ViewBag.FirstName</td>
                    </tr>
                    <tr>
                        <th>Last Name</th>
                        <td>@ViewBag.LastName</td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td>@ViewBag.Email</td>
                    </tr>
                    <tr>
                        <th>Phone</th>
                        <td>@ViewBag.Phone</td>
                    </tr>
                    <tr>
                        <th>Role</th>
                        <td>
                            @if (ViewBag.RoleId == "1") { <text>Administrator</text> }
                            else if (ViewBag.RoleId == "2") { <text>Pharmacist</text> }
                            else if (ViewBag.RoleId == "3") { <text>Store Clerk</text> }
                            else { <text>Staff</text> }
                        </td>
                    </tr>
                </table>

                <div class="m-t-20">
                    <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-primary"><i class="fa fa-key"></i> Change Password</a>
                </div>
            </div>
        </div>
    </div>
</div>