@section PageStyles {
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-cog"></i> Settings <small>Profile &amp; Pharmacy</small></h1>

<div class="row">
    <div class="col-md-12">
        <!-- ── My Profile ── -->
        <div class="panel panel-inverse">
            <div class="panel-heading">
                <h4 class="panel-title"><i class="fa fa-user-circle"></i> My Profile</h4>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-bordered table-condensed m-b-0">
                            <tr>
                                <th style="width:40%;">First Name</th>
                                <td>@ViewBag.FirstName</td>
                            </tr>
                            <tr>
                                <th>Last Name</th>
                                <td>@ViewBag.LastName</td>
                            </tr>
                            <tr>
                                <th>Email</th>
                                <td>@ViewBag.Email</td>
                            </tr>
                            <tr>
                                <th>Phone</th>
                                <td>@ViewBag.Phone</td>
                            </tr>
                            <tr>
                                <th>Role</th>
                                <td>
                                    @if (ViewBag.RoleId == "1") { <text>Administrator</text> }
                                    else if (ViewBag.RoleId == "2") { <text>Pharmacist</text> }
                                    else if (ViewBag.RoleId == "3") { <text>Store Clerk</text> }
                                    else { <text>Staff</text> }
                                </td>
                            </tr>
                        </table>
                        <div class="m-t-15">
                            <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-primary btn-sm"><i class="fa fa-key"></i> Change Password</a>
                        </div>
                    </div>

                    <!-- ── Pharmacy Status ── -->
                    <div class="col-md-6">
                        <div class="panel panel-inverse" style="margin:0;">
                            <div class="panel-heading"><h4 class="panel-title" style="color:#fff;"><i class="fa fa-info-circle"></i> Pharmacy Status</h4></div>
                            <div class="panel-body" id="pharmacyStatus"><i class="fa fa-spinner fa-spin"></i> Loading...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Pharmacy Settings ── -->
        <div class="panel panel-inverse">
            <div class="panel-heading">
                <h4 class="panel-title"><i class="fa fa-hospital-o"></i> Pharmacy Information</h4>
            </div>
            <div class="panel-body">
                <form id="pharmacyForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Pharmacy Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="pharmacyName" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Slug / Code</label>
                                <input type="text" class="form-control" id="slug" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Phone</label>
                                <input type="text" class="form-control" id="pharmacyPhone" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" class="form-control" id="pharmacyEmail" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Physical Address</label>
                        <textarea class="form-control" id="address" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>License Number</label>
                                <input type="text" class="form-control" id="licenseNumber" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>License Expiry</label>
                                <input type="text" class="form-control" id="licenseExpiry" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>VAT Number</label>
                                <input type="text" class="form-control" id="vatNumber" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Currency</label>
                                <select class="form-control" id="currency">
                                    <option value="KES">KES — Kenyan Shilling</option>
                                    <option value="USD">USD — US Dollar</option>
                                    <option value="UGX">UGX — Ugandan Shilling</option>
                                    <option value="TZS">TZS — Tanzanian Shilling</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Receipt Footer</label>
                        <textarea class="form-control" id="receiptFooter" rows="2" placeholder="Thank you for shopping with us!"></textarea>
                    </div>

                    <hr />
                    <h4><i class="fa fa-sliders"></i> Operational Settings</h4>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Default Tax Rate (%)</label>
                                <input type="number" class="form-control" id="taxRate" step="0.01" min="0" max="100" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Default Discount Limit (%)</label>
                                <input type="number" class="form-control" id="discountLimit" step="0.01" min="0" max="100" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Low Stock Alert Days</label>
                                <input type="number" class="form-control" id="lowStockDays" min="1" />
                            </div>
                        </div>
                    </div>

                    <div class="m-t-20">
                        <button type="submit" class="btn btn-success" id="btnSavePharmacy"><i class="fa fa-save"></i> Save Settings</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        $(document).ready(function () { LoadPharmacy(); });

        function LoadPharmacy() {
            ajaxGet('/Settings/GetPharmacy', function (data) {
                if (!data) { $('#pharmacyStatus').html('<p class="text-muted">No pharmacy profile found.</p>'); return; }

                $('#pharmacyName').val(data.name || '');
                $('#slug').val(data.slug || '');
                $('#pharmacyPhone').val(data.phone || '');
                $('#pharmacyEmail').val(data.email || '');
                $('#address').val(data.address || '');
                $('#licenseNumber').val(data.license_number || '');
                $('#licenseExpiry').val(data.license_expiry ? String(data.license_expiry).substring(0, 10) : '');
                $('#vatNumber').val(data.vat_number || '');
                $('#currency').val(data.currency || 'KES');
                $('#receiptFooter').val(data.receipt_footer || '');
                if (data.tax_rate) $('#taxRate').val(data.tax_rate);
                if (data.discount_limit) $('#discountLimit').val(data.discount_limit);
                if (data.low_stock_alert_days) $('#lowStockDays').val(data.low_stock_alert_days);

                var statusHtml = '<table class="table table-condensed m-b-0">';
                statusHtml += '<tr><td><strong>Status</strong></td><td><span class="label label-success">Active</span></td></tr>';
                statusHtml += '<tr><td><strong>Slug</strong></td><td>' + (data.slug || '-') + '</td></tr>';
                statusHtml += '<tr><td><strong>License</strong></td><td>' + (data.license_number || '-') + '</td></tr>';
                statusHtml += '<tr><td><strong>Currency</strong></td><td>' + (data.currency || 'KES') + '</td></tr>';
                statusHtml += '</table>';
                $('#pharmacyStatus').html(statusHtml);
            }, function () {
                $('#pharmacyStatus').html('<p class="text-muted">Unable to load pharmacy profile.</p>');
            });
        }

        $('#pharmacyForm').on('submit', function (e) {
            e.preventDefault();
            var btn = this;
            btnLoad(btn, 'Saving...');
            ajaxPost('/Settings/UpdatePharmacy', {
                pharmacy_name: $('#pharmacyName').val().trim(),
                pharmacy_phone: $('#pharmacyPhone').val().trim() || null,
                pharmacy_email: $('#pharmacyEmail').val().trim() || null,
                pharmacy_address: $('#address').val().trim() || null,
                license_number: $('#licenseNumber').val().trim() || null,
                vat_number: $('#vatNumber').val().trim() || null,
                receipt_footer: $('#receiptFooter').val().trim() || null,
                currency: $('#currency').val() || 'KES'
            }, function (res) {
                if (!res.success) return SaveFail(btn, res.message);
                SaveConfigs(function () {
                    btnStop(btn);
                    Swal.fire('Saved', 'Pharmacy settings updated.', 'success');
                    LoadPharmacy();
                });
            }, function () { SaveFail(btn, 'Request failed.'); });
        });

        function SaveConfigs(done) {
            var pending = 3;
            var doneAll = function () { if (--pending === 0 && done) done(); };
            var finish = function (e) { doneAll(); };
            ajaxPost('/Settings/SavePharmacyConfig', { key: 'tax_rate', value: $('#taxRate').val() || '' }, finish, finish);
            ajaxPost('/Settings/SavePharmacyConfig', { key: 'discount_limit', value: $('#discountLimit').val() || '' }, finish, finish);
            ajaxPost('/Settings/SavePharmacyConfig', { key: 'low_stock_alert_days', value: $('#lowStockDays').val() || '' }, finish, finish);
        }

        function SaveFail(btn, msg) {
            btnStop(btn);
            Swal.fire('Error', msg || 'Unable to save.', 'error');
        }
    </script>
}
