@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-money"></i> Expenses <small>Finance</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("Expenses", "Finance")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
        </div>
        <h4 class="panel-title">Expenses</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-12">
                <button class="btn btn-sm btn-success" data-toggle="modal" data-target="#expenseModal" onclick="resetForm();">
                    <i class="fa fa-plus"></i> Add Expense
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="expensesTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th>Payment Method</th>
                            <th>Reference</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Expense Modal -->
<div class="modal fade" id="expenseModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="expenseForm">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title" id="modalLabel"><i class="fa fa-money"></i> Add Expense</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Date <span class="text-danger">*</span></label>
                                <input type="text" class="form-control date-picker" id="expenseDate" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Category <span class="text-danger">*</span></label>
                                <select class="form-control select2" id="expenseCategory" required>
                                    <option value="">-- Select --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Amount (KES) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="amount" step="0.01" min="0.01" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Payment Method <span class="text-danger">*</span></label>
                                <select class="form-control" id="paymentMethod" required>
                                    <option value="Cash">Cash</option>
                                    <option value="Mpesa">M-Pesa</option>
                                    <option value="Bank">Bank Transfer</option>
                                    <option value="Card">Card</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Description <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="description" rows="3" required></textarea>
                    </div>
                    <div class="form-group">
                        <label>Reference / Invoice #</label>
                        <input type="text" class="form-control" id="reference" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                    <button type="button" class="btn btn-success" id="btnSaveExpense"><i class="fa fa-save"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete uses SweetAlert2 -->

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/assets/static/plugins/select2/dist/js/select2.full.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script>
        // ============================================================
        //  Expenses — (Riziki BFF pattern)
        // ============================================================
        var table;

        $(document).ready(function () {
            $('.select2').select2({ width: '100%' });
            $('.date-picker').datepicker({ autoclose: true, todayHighlight: true, format: 'dd M yyyy' });
            table = initTable();
            loadExpenses();
            loadExpenseCategories();

            $('#expenseModal').on('hidden.bs.modal', function () { resetForm(); });
        });

        function initTable() {
            return $('#expensesTable').dataTable({
                responsive: true,
                createdRow: function (row, data) { $(row).attr('recid', data.id); },
                aoColumns: [
                    { data: 'expense_date', autoWidth: true, sDefaultContent: '-', render: function (d) { return formatDate(d); } },
                    { data: 'category_name', autoWidth: true, sDefaultContent: '-' },
                    { data: 'description', autoWidth: true, sDefaultContent: '-' },
                    { data: 'amount', autoWidth: true, sDefaultContent: '0.00', render: function (d) { return '<strong>KES ' + parseFloat(d || 0).toFixed(2) + '</strong>'; } },
                    { data: 'payment_method', autoWidth: true, sDefaultContent: '-' },
                    { data: 'reference', autoWidth: true, sDefaultContent: '-' },
                    { bSortable: false, sDefaultContent: '<button class="btn btn-danger btn-xs delete-exp"><i class="fa fa-trash"></i></button>' }
                ]
            });
        }

        function loadExpenses() {
            ajaxGet('/Finance/GetExpenses', function (data) {
                var s = table.fnSettings();
                table.fnClearTable(true);
                for (var i = 0; i < data.length; i++) table.oApi._fnAddData(s, data[i]);
                s.aiDisplay = s.aiDisplayMaster.slice();
                table.fnDraw();
            });
        }

        function loadExpenseCategories() {
            ajaxGet('/Finance/GetExpenseCategories', function (data) {
                var opt = '<option value="">-- Select --</option>';
                for (var i = 0; i < data.length; i++)
                    opt += '<option value="' + data[i].id + '">' + data[i].name + '</option>';
                $('#expenseCategory').html(opt);
            });
        }

        function resetForm() {
            $('#expenseForm')[0].reset();
            $('#expenseModal').find('.select2').val('').trigger('change');
            $('.date-picker').datepicker('update', new Date());
            $('#modalLabel').html('<i class="fa fa-money"></i> Add Expense');
        }

        function formatDate(d) { return d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '-'; }

        // ── Delete ───────────────────────────────────────────────────────────
        $('#expensesTable').on('click', 'button.delete-exp', function (e) {
            e.preventDefault();
            var d = table.fnGetData($(this).parents('tr')[0]);
            Swal.fire({
                title: 'Delete Expense?',
                text: 'Delete "' + (d.description || '') + '"? This cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, Delete',
                reverseButtons: true
            }).then(function (r) {
                if (!r.isConfirmed) return;
                ajaxPost('/Finance/DeleteExpense', { id: d.id }, function (res) {
                    if (res.success) {
                        loadExpenses();
                        Swal.fire('Deleted', res.message, 'success');
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                });
            });
        });

        // ── Save ─────────────────────────────────────────────────────────────
        $('#btnSaveExpense').on('click', function (e) {
            e.preventDefault();
            if (!$('#expenseCategory').val() || !$('#description').val().trim() || !$('#amount').val()) {
                Swal.fire('Validation', 'Category, description and amount are required.', 'warning');
                return;
            }
            var btn = this;
            btnLoad(btn, 'Saving...');
            ajaxPost('/Finance/AddExpense', {
                category_id: parseInt($('#expenseCategory').val()),
                description: $('#description').val().trim(),
                amount: parseFloat($('#amount').val()),
                expense_date: $('#expenseDate').eq(0).val(),
                payment_method: $('#paymentMethod').val(),
                reference: $('#reference').val().trim() || null
            }, function (res) {
                btnStop(btn);
                if (res.success) {
                    $('#expenseModal').modal('hide');
                    loadExpenses();
                    Swal.fire('Saved', res.message, 'success');
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            }, function () { btnStop(btn); Swal.fire('Error', 'Request failed.', 'error'); });
        });
    </script>
}
