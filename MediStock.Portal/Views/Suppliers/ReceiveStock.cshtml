@{
    ViewData["Title"] = "Receive Stock";
}

<div style="display:none;">@Html.AntiForgeryToken()</div>

<h1 class="page-header"><i class="fa fa-truck"></i> Receive Stock <small>Purchase Order</small></h1>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-inverse">
            <div class="panel-heading">
                <h4 class="panel-title"><i class="fa fa-file-text-o"></i> PO: <span id="poNumber">Loading...</span></h4>
            </div>
            <div class="panel-body">
                <div id="poInfo" class="row m-b-20">
                    <div class="col-md-3"><strong>Supplier:</strong> <span id="poSupplier">-</span></div>
                    <div class="col-md-3"><strong>Date:</strong> <span id="poDate">-</span></div>
                    <div class="col-md-3"><strong>Status:</strong> <span id="poStatus">-</span></div>
                    <div class="col-md-3"><strong>Total:</strong> <span id="poTotal">-</span></div>
                </div>

                <form id="receiveForm">
                    <table class="table table-striped table-condensed" id="receiveLines">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Ordered Qty</th>
                                <th>Already Received</th>
                                <th>Pending Qty</th>
                                <th>Receive Qty Now</th>
                                <th>Batch Number</th>
                                <th>Expiry Date</th>
                                <th>Unit Cost</th>
                            </tr>
                        </thead>
                        <tbody id="receiveBody">
                            <tr><td colspan="8" class="text-center"><i class="fa fa-spinner fa-spin"></i> Loading...</td></tr>
                        </tbody>
                    </table>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Delivery Note Number</label>
                                <input type="text" class="form-control" id="deliveryNote" name="deliveryNoteNumber" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Notes</label>
                                <textarea class="form-control" id="receiveNotes" name="notes" rows="2"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="m-t-20">
                        <button type="submit" class="btn btn-success" id="receiveBtn"><i class="fa fa-check"></i> Confirm Receipt</button>
                        <a href="/Suppliers/PurchaseOrders" class="btn btn-default"><i class="fa fa-arrow-left"></i> Back to POs</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        var poId = '@ViewBag.PoId';

        $(document).ready(function () {
            if (poId) loadPO();
        });

        function loadPO() {
            $.get('/api/purchase-orders/' + poId, function (data) {
                $('#poNumber').text(data.poNumber);
                $('#poSupplier').text(data.supplierName);
                $('#poDate').text(formatDate(data.orderDate));
                $('#poStatus').html('<span class="label label-info">' + data.status + '</span>');
                $('#poTotal').text('KES ' + parseFloat(data.totalAmount).toFixed(2));

                var html = '';
                $.each(data.lines, function (i, line) {
                    var pending = line.quantity - line.receivedQuantity;
                    html += '<tr>';
                    html += '<td>' + line.productName + '</td>';
                    html += '<td>' + line.quantity + '</td>';
                    html += '<td>' + line.receivedQuantity + '</td>';
                    html += '<td>' + pending + '</td>';
                    html += '<td><input type="number" class="form-control input-sm recv-qty" data-line="' + i + '" data-pending="' + pending + '" min="0" max="' + pending + '" value="0" /></td>';
                    html += '<td><input type="text" class="form-control input-sm recv-batch" data-line="' + i + '" required /></td>';
                    html += '<td><input type="date" class="form-control input-sm recv-expiry" data-line="' + i + '" required /></td>';
                    html += '<td><input type="number" class="form-control input-sm recv-cost" data-line="' + i + '" value="' + line.unitCost + '" step="0.01" /></td>';
                    html += '</tr>';
                });
                $('#receiveBody').html(html);
            });
        }

        function formatDate(d) {
            return d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';
        }

        $('#receiveForm').on('submit', function (e) {
            e.preventDefault();
            var items = [];
            var valid = true;

            $('#receiveBody tr').each(function () {
                var qty = parseInt($(this).find('.recv-qty').val()) || 0;
                var pending = parseInt($(this).find('.recv-qty').data('pending')) || 0;
                if (qty > pending) { valid = false; return; }

                if (qty > 0) {
                    items.push({
                        lineIndex: $(this).find('.recv-qty').data('line'),
                        receivedQuantity: qty,
                        batchNumber: $(this).find('.recv-batch').val(),
                        expiryDate: $(this).find('.recv-expiry').val(),
                        unitCost: parseFloat($(this).find('.recv-cost').val()) || 0
                    });
                }
            });

            if (!valid) { Swal.fire('Error', 'Receive quantity exceeds pending quantity.', 'error'); return; }
            if (items.length === 0) { Swal.fire('Notice', 'Enter at least one item to receive.', 'info'); return; }

            var payload = {
                poId: poId,
                deliveryNoteNumber: $('#deliveryNote').val(),
                notes: $('#receiveNotes').val(),
                items: items
            };

            Swal.fire({
                title: 'Confirm Receipt',
                text: 'Receive ' + items.length + ' item(s)?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745'
            }).then(function (result) {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/api/stock/receive',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                        success: function () {
                            Swal.fire('Received', 'Stock received successfully.', 'success');
                            loadPO();
                        },
                        error: function (xhr) { Swal.fire('Error', xhr.responseText || 'Unable to receive stock.', 'error'); }
                    });
                }
            });
        });
    </script>
}
