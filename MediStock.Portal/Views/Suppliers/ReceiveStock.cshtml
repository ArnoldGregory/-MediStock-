@section PageStyles {
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-truck"></i> Receive Stock <small>Purchase Order</small></h1>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-inverse">
            <div class="panel-heading">
                <h4 class="panel-title"><i class="fa fa-file-text-o"></i> PO: <span id="poNumber">Loading...</span></h4>
            </div>
            <div class="panel-body">
                <div id="poInfo" class="row m-b-20">
                    <div class="col-md-3"><strong>Supplier:</strong> <span id="poSupplier">-</span></div>
                    <div class="col-md-3"><strong>Date:</strong> <span id="poDate">-</span></div>
                    <div class="col-md-3"><strong>Status:</strong> <span id="poStatus">-</span></div>
                    <div class="col-md-3"><strong>Total:</strong> <span id="poTotal">-</span></div>
                </div>

                <form id="receiveForm">
                    <table class="table table-striped table-condensed">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Ordered Qty</th>
                                <th>Receive Qty Now</th>
                            </tr>
                        </thead>
                        <tbody id="receiveBody">
                            <tr><td colspan="3" class="text-center"><i class="fa fa-spinner fa-spin"></i> Loading...</td></tr>
                        </tbody>
                    </table>

                    <div class="form-group">
                        <label>Notes</label>
                        <textarea class="form-control" id="receiveNotes" rows="2"></textarea>
                    </div>

                    <div class="m-t-20">
                        <button type="button" class="btn btn-success" id="receiveBtn"><i class="fa fa-check"></i> Confirm Receipt</button>
                        <a href="/Suppliers/PurchaseOrders" class="btn btn-default"><i class="fa fa-arrow-left"></i> Back to POs</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        // ============================================================
        //  Receive Stock — (Riziki BFF pattern)
        // ============================================================
        var poId = @(ViewBag.PoId ?? 0);
        var poRow = null;

        $(document).ready(function () {
            if (poId) loadPO();
            else $('#receiveBody').html('<tr><td colspan="3" class="text-center">No purchase order selected.</td></tr>');
        });

        function loadPO() {
            ajaxGet('/Suppliers/GetPurchaseOrder?id=' + poId, function (data) {
                if (!data || !data.length) {
                    $('#receiveBody').html('<tr><td colspan="3" class="text-center text-danger">Purchase order not found.</td></tr>');
                    return;
                }
                poRow = data[0];
                $('#poNumber').text(poRow.po_number || ('PO-' + poId));
                $('#poSupplier').text(poRow.supplier_name || '-');
                $('#poDate').text(formatDate(poRow.created_on));
                $('#poStatus').html('<span class="label label-info">' + (poRow.status || '-') + '</span>');
                $('#poTotal').text('KES ' + parseFloat(poRow.total || 0).toFixed(2));

                ajaxGet('/Products/GetProduct?id=' + poRow.product_id, function (pdata) {
                    var productName = (pdata && pdata.length && pdata[0].name) ? pdata[0].name : ('Product #' + poRow.product_id);
                    $('#receiveBody').html(
                        '<tr>' +
                        '<td>' + productName + '</td>' +
                        '<td>' + (poRow.quantity || 0) + '</td>' +
                        '<td><input type="number" class="form-control input-sm" id="recvQty" min="0" max="' + (poRow.quantity || 0) + '" value="' + (poRow.quantity || 0) + '" required /></td>' +
                        '</tr>'
                    );
                });
            });
        }

        function formatDate(d) {
            return d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';
        }

        $('#receiveBtn').on('click', function (e) {
            e.preventDefault();
            if (!poRow) return;
            var qty = parseInt($('#recvQty').val()) || 0;
            if (qty <= 0) { Swal.fire('Validation', 'Enter a quantity to receive.', 'warning'); return; }
            var max = poRow.quantity || 0;
            if (qty > max) { Swal.fire('Validation', 'Receive quantity exceeds ordered quantity (' + max + ').', 'warning'); return; }

            Swal.fire({
                title: 'Confirm Receipt',
                text: 'Receive ' + qty + ' item(s)?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745'
            }).then(function (result) {
                if (!result.isConfirmed) return;
                var btn = $('#receiveBtn')[0];
                btnLoad(btn, 'Receiving...');
                ajaxPost('/Suppliers/ReceivePurchaseOrder', {
                    id: poId,
                    quantity_received: qty,
                    notes: $('#receiveNotes').val().trim() || null
                }, function (res) {
                    btnStop(btn);
                    if (res.success) {
                        Swal.fire('Received', res.message, 'success');
                        loadPO();
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                }, function () { btnStop(btn); Swal.fire('Error', 'Request failed.', 'error'); });
            });
        });
    </script>
}
