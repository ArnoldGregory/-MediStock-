@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-file-text-o"></i> Purchase Orders <small>Procurement</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("PurchaseOrders", "Suppliers")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
        </div>
        <h4 class="panel-title">Purchase Orders</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-12">
                <button class="btn btn-sm btn-success" data-toggle="modal" data-target="#poModal" onclick="resetPOForm();">
                    <i class="fa fa-plus"></i> Create Purchase Order
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="poTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>PO Number</th>
                            <th>Date</th>
                            <th>Supplier</th>
                            <th>Total Amount</th>
                            <th>Expected Date</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create PO Modal -->
<div class="modal fade" id="poModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="poForm">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title"><i class="fa fa-file-text-o"></i> Create Purchase Order</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Supplier <span class="text-danger">*</span></label>
                                <select class="form-control select2" id="poSupplier" required>
                                    <option value="">-- Select Supplier --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Expected Delivery Date</label>
                                <input type="text" class="form-control date-picker" id="expectedDate" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Product <span class="text-danger">*</span></label>
                                <select class="form-control select2" id="poProduct" required>
                                    <option value="">-- Select Product --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Quantity <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="poQty" min="1" required />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Unit Cost (KES) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="poCost" step="0.01" min="0" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Total</label>
                                <input type="text" class="form-control" id="poTotal" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Notes</label>
                        <textarea class="form-control" id="poNotes" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                    <button type="button" class="btn btn-success" id="btnCreatePO"><i class="fa fa-save"></i> Create PO</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/assets/static/plugins/select2/dist/js/select2.full.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script>
        // ============================================================
        //  Purchase Orders — (Riziki BFF pattern)
        // ============================================================
        var poTable;

        $(document).ready(function () {
            $('.select2').select2({ width: '100%' });
            $('.date-picker').datepicker({ autoclose: true, todayHighlight: true, format: 'dd M yyyy' });
            poTable = initTable();
            loadPOs();
            loadSuppliersForPO();
            loadProductsForPO();

            $('#poModal').on('hidden.bs.modal', function () { resetPOForm(); });
        });

        function initTable() {
            return $('#poTable').dataTable({
                responsive: true,
                createdRow: function (row, data) { $(row).attr('recid', data.id); },
                aoColumns: [
                    { data: 'po_number', autoWidth: true, sDefaultContent: '-' },
                    { data: 'created_on', autoWidth: true, sDefaultContent: '-', render: function (d) { return formatDate(d); } },
                    { data: 'supplier_name', autoWidth: true, sDefaultContent: '-' },
                    { data: 'total', autoWidth: true, sDefaultContent: '0.00', render: function (d) { return 'KES ' + parseFloat(d || 0).toFixed(2); } },
                    { data: 'expected_date', autoWidth: true, sDefaultContent: '-', render: function (d) { return formatDate(d); } },
                    { data: 'status', autoWidth: true, sDefaultContent: '-', render: function (d) {
                        var cls = { 'Draft': 'label-default', 'Pending': 'label-info', 'Partial': 'label-warning', 'Received': 'label-success', 'Cancelled': 'label-danger' };
                        return '<span class="label ' + (cls[d] || 'label-info') + '">' + (d || '-') + '</span>';
                    } },
                    { bSortable: false, sDefaultContent: '<button class="btn btn-success btn-xs receive-po"><i class="fa fa-truck"></i> Receive</button>' }
                ]
            });
        }

        function loadPOs() {
            ajaxGet('/Suppliers/GetPurchaseOrders', function (data) {
                var s = poTable.fnSettings();
                poTable.fnClearTable(true);
                for (var i = 0; i < data.length; i++) poTable.oApi._fnAddData(s, data[i]);
                s.aiDisplay = s.aiDisplayMaster.slice();
                poTable.fnDraw();
            });
        }

        function loadSuppliersForPO() {
            ajaxGet('/Suppliers/GetSuppliers', function (data) {
                var opt = '<option value="">-- Select Supplier --</option>';
                for (var i = 0; i < data.length; i++)
                    opt += '<option value="' + data[i].id + '">' + data[i].name + '</option>';
                $('#poSupplier').html(opt);
            });
        }

        function loadProductsForPO() {
            ajaxGet('/Products/GetProducts', function (data) {
                window._poProducts = data;
                var opt = '<option value="">-- Select Product --</option>';
                for (var i = 0; i < data.length; i++)
                    opt += '<option value="' + data[i].id + '" data-cost="' + (data[i].cost_price || 0) + '">' + data[i].name + '</option>';
                $('#poProduct').html(opt);
            });
        }

        // ── Receive ───────────────────────────────────────────────────────────
        $('#poTable').on('click', 'button.receive-po', function (e) {
            e.preventDefault();
            var d = poTable.fnGetData($(this).parents('tr')[0]);
            if (d.status === 'Received') { Swal.fire('Info', 'This PO is already fully received.', 'info'); return; }
            window.location.href = '/Suppliers/ReceiveStock?id=' + d.id;
        });

        // ── Create PO ─────────────────────────────────────────────────────────
        $('#poProduct').on('change', function () {
            var cost = $(this).find('option:selected').data('cost');
            if (cost && !$('#poCost').val()) $('#poCost').val(cost);
            updateTotal();
        });
        $('#poQty, #poCost').on('input', updateTotal);

        function updateTotal() {
            var q = parseInt($('#poQty').val()) || 0;
            var c = parseFloat($('#poCost').val()) || 0;
            $('#poTotal').val('KES ' + (q * c).toFixed(2));
        }

        function resetPOForm() {
            $('#poForm')[0].reset();
            $('#poModal').find('.select2').val('').trigger('change');
            $('#poTotal').val('');
        }

        function formatDate(d) {
            return d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';
        }

        $('#btnCreatePO').on('click', function (e) {
            e.preventDefault();
            var supplierId = $('#poSupplier').val();
            var productId = $('#poProduct').val();
            var qty = parseInt($('#poQty').val()) || 0;
            var cost = parseFloat($('#poCost').val()) || 0;
            if (!supplierId || !productId || qty <= 0 || cost <= 0) {
                Swal.fire('Validation', 'Supplier, product, quantity and unit cost are required.', 'warning');
                return;
            }
            var btn = this;
            btnLoad(btn, 'Creating...');
            ajaxPost('/Suppliers/CreatePurchaseOrder', {
                supplier_id: supplierId,
                product_id: productId,
                quantity: qty,
                unit_cost: cost,
                expected_date: $('#expectedDate').eq(0).val() || null,
                notes: $('#poNotes').val().trim() || null
            }, function (res) {
                btnStop(btn);
                if (res.success) {
                    $('#poModal').modal('hide');
                    loadPOs();
                    Swal.fire('Created', res.message, 'success');
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            }, function () { btnStop(btn); Swal.fire('Error', 'Request failed.', 'error'); });
        });
    </script>
}
