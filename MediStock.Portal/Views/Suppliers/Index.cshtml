@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-truck"></i> Suppliers <small>Register</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("Index", "Suppliers")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
        </div>
        <h4 class="panel-title">Suppliers</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-12">
                <button class="btn btn-sm btn-success" data-toggle="modal" data-target="#supplierModal" onclick="resetForm();">
                    <i class="fa fa-plus"></i> Add Supplier
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="suppliersTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Supplier Name</th>
                            <th>Contact Person</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Status</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="supplierModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form id="supplierForm">
                <input type="hidden" id="supplierId" value="" />
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title" id="modalLabel"><i class="fa fa-truck"></i> Add Supplier</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Supplier Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="supplierName" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Contact Person</label>
                                <input type="text" class="form-control" id="contactPerson" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Phone</label>
                                <input type="text" class="form-control" id="phone" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" class="form-control" id="email" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>City</label>
                                <input type="text" class="form-control" id="city" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Country</label>
                                <input type="text" class="form-control" id="country" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Address</label>
                        <textarea class="form-control" id="address" rows="2"></textarea>
                    </div>
                    <div class="form-group">
                        <label><input type="checkbox" id="isActive" checked /> Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                    <button type="button" class="btn btn-success" id="btnSaveSupplier"><i class="fa fa-save"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        // ============================================================
        //  Suppliers — Index (Riziki BFF pattern)
        // ============================================================
        var _supTable;

        $(document).ready(function () {
            _supTable = InitSupTable();
            LoadSuppliers(_supTable);

            $('#supplierModal').on('hidden.bs.modal', function () {
                ResetSupplierForm();
            });
        });

        function InitSupTable() {
            var t = $('#suppliersTable').dataTable({
                responsive: true,
                createdRow: function (row, data) { $(row).attr('recid', data.id); },
                aoColumns: [
                    { data: 'name',           autoWidth: true, sDefaultContent: '-' },
                    { data: 'contact_person', autoWidth: true, sDefaultContent: '-' },
                    { data: 'phone',          autoWidth: true, sDefaultContent: '-' },
                    { data: 'email',          autoWidth: true, sDefaultContent: '-' },
                    { data: 'address',        autoWidth: true, sDefaultContent: '-' },
                    { data: 'is_active',      autoWidth: true, sDefaultContent: 'Active', render: function (d) { return (d == 1 || d === true) ? '<span class="label label-success">Active</span>' : '<span class="label label-default">Inactive</span>'; } },
                    { bSortable: false, sDefaultContent: '<button class="btn btn-warning btn-xs edit-sup"><i class="fa fa-edit"></i> Edit</button>' },
                    { bSortable: false, sDefaultContent: '<button class="btn btn-danger btn-xs delete-sup"><i class="fa fa-trash"></i> Delete</button>' }
                ]
            });
            return t;
        }

        function LoadSuppliers(oTable) {
            ajaxGet('/Suppliers/GetSuppliers', function (data) {
                var t = oTable || _supTable;
                var s = t.fnSettings();
                t.fnClearTable(true);
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) t.oApi._fnAddData(s, data[i]);
                }
                s.aiDisplay = s.aiDisplayMaster.slice();
                t.fnDraw();
            });
        }

        function ResetSupplierForm() {
            $('#supplierForm')[0].reset();
            $('#supplierId').val('');
            $('#isActive').prop('checked', true);
            $('#modalLabel').html('<i class="fa fa-truck"></i> Add Supplier');
        }

        function GetSupplierForm() {
            return {
                name: $('#supplierName').val().trim(),
                contact_person: $('#contactPerson').val().trim() || null,
                phone: $('#phone').val().trim() || null,
                email: $('#email').val().trim() || null,
                address: $('#address').val().trim() || null,
                city: $('#city').val().trim() || null,
                country: $('#country').val().trim() || null,
                is_active: $('#isActive').is(':checked')
            };
        }

        // ── Edit ─────────────────────────────────────────────────────────────
        $('#suppliersTable').on('click', 'button.edit-sup', function (e) {
            e.preventDefault();
            var d = _supTable.fnGetData($(this).parents('tr')[0]);
            $('#supplierId').val(d.id);
            $('#supplierName').val(d.name || '');
            $('#contactPerson').val(d.contact_person || '');
            $('#phone').val(d.phone || '');
            $('#email').val(d.email || '');
            $('#address').val(d.address || '');
            $('#city').val(d.city || '');
            $('#country').val(d.country || '');
            $('#isActive').prop('checked', !(d.is_active == 0 || d.is_active === false));
            $('#modalLabel').html('<i class="fa fa-edit"></i> Edit Supplier');
            $('#supplierModal').modal('show');
        });

        // ── Delete ───────────────────────────────────────────────────────────
        $('#suppliersTable').on('click', 'button.delete-sup', function (e) {
            e.preventDefault();
            var d = _supTable.fnGetData($(this).parents('tr')[0]);
            Swal.fire({
                title: 'Delete Supplier?',
                text: 'Delete "' + d.name + '"? This cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, Delete',
                reverseButtons: true
            }).then(function (r) {
                if (!r.isConfirmed) return;
                ajaxPost('/Suppliers/DeleteSupplier', { id: d.id }, function (res) {
                    if (res.success) {
                        LoadSuppliers(_supTable);
                        Swal.fire('Deleted', res.message, 'success');
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                });
            });
        });

        // ── Save (add / update) ──────────────────────────────────────────────
        $('#btnSaveSupplier').on('click', function (e) {
            e.preventDefault();
            var name = $('#supplierName').val().trim();
            if (!name) { Swal.fire('Validation', 'Supplier name is required.', 'warning'); return; }
            var id = parseInt($('#supplierId').val()) || 0;
            var url = id ? '/Suppliers/UpdateSupplier' : '/Suppliers/AddSupplier';
            var payload = GetSupplierForm();
            if (id) payload.id = id;
            var btn = this;
            btnLoad(btn, 'Saving...');
            ajaxPost(url, payload, function (res) {
                btnStop(btn);
                if (res.success) {
                    $('#supplierModal').modal('hide');
                    LoadSuppliers(_supTable);
                    Swal.fire(id ? 'Updated' : 'Saved', res.message, 'success');
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            }, function () { btnStop(btn); Swal.fire('Error', 'Request failed.', 'error'); });
        });
    </script>
}
