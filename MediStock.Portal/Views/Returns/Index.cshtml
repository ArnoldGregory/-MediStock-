@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <style>
        .ret-qty { width: 70px; text-align: right; }
        #returnItemsTable td, #returnItemsTable th { vertical-align: middle; }
    </style>
}

<h1 class="page-header"><i class="fa fa-undo"></i> Sales Returns <small>Restock & Credit Notes</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("Index", "Returns")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
            <button type="button" class="btn btn-xs btn-primary" onclick="openReturnModal();"><i class="fa fa-undo"></i> New Return</button>
        </div>
        <h4 class="panel-title">Return Records</h4>
    </div>
    <div class="panel-body">
        <table id="returnsTable" class="table table-striped table-hover table-bordered table-condensed">
            <thead>
                <tr>
                    <th>Return #</th>
                    <th>Date</th>
                    <th>Sale #</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Refund</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- New Return Modal -->
<div class="modal fade" id="returnModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title"><i class="fa fa-undo"></i> New Sales Return</h4>
            </div>
            <div class="modal-body">
                <div class="row m-b-10">
                    <div class="col-md-5">
                        <label>Sale</label>
                        <select id="retSale" class="form-control input-sm" onchange="loadReturnable();">
                            <option value="0">-- Select a sale --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Re-open last sale</label>
                        <div><a href="#" onclick="reloadSales(); return false;"><i class="fa fa-repeat"></i> Refresh sales</a></div>
                    </div>
                </div>
                <div class="row m-b-10">
                    <div class="col-md-9">
                        <label>Reason</label>
                        <select id="retReason" class="form-control input-sm">
                            <option value="Customer changed mind">Customer changed mind</option>
                            <option value="Wrong item dispensed">Wrong item dispensed</option>
                            <option value="Damaged or expired on receipt">Damaged or expired on receipt</option>
                            <option value="Duplicate sale">Duplicate sale</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
                <div class="row" id="retItemsWrap" style="display:none;">
                    <div class="col-md-12">
                        <table id="returnItemsTable" class="table table-striped table-bordered table-condensed">
                            <thead>
                                <tr>
                                    <th style="width:28px;"><input type="checkbox" id="retSelAll" onchange="toggleAll();" /></th>
                                    <th>Product</th>
                                    <th>SKU</th>
                                    <th class="text-right">Sold</th>
                                    <th class="text-right">Returned</th>
                                    <th class="text-right">Remaining</th>
                                    <th class="text-right">Unit Price</th>
                                    <th class="text-center" style="width:100px;">Qty</th>
                                    <th class="text-right" style="width:130px;">Refund KES</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <div class="text-right">
                            <strong>Total refund: KES <span id="retTotal">0.00</span></strong>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="btn btn-success" id="btnSaveReturn" onclick="saveReturn();"><i class="fa fa-check"></i> Record Return</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        var retTable;
        var salesList = [];
        var returnable = [];
        var selectedReturnDetail = null;

        $(document).ready(function () {
            retTable = $('#returnsTable').dataTable({
                responsive: true,
                aoColumns: [
                    { data: 'return_number', autoWidth: true, orderable: false },
                    { data: 'created_on', autoWidth: true, render: function (d) { return formatDate(d); } },
                    { data: 'sale_number', autoWidth: true, sDefaultContent: '-' },
                    { data: 'customer_name', autoWidth: true, sDefaultContent: 'Walk-In' },
                    { data: 'item_count', autoWidth: true, sDefaultContent: '0' },
                    { data: 'total_refund', autoWidth: true, sDefaultContent: '0.00', render: function (d) { return '<strong>KES ' + fmt(d) + '</strong>'; } },
                    { data: 'reason', autoWidth: true, sDefaultContent: '-' },
                    { data: 'status', autoWidth: true, sDefaultContent: '-', render: function (d) {
                        return '<span class="label label-success">' + (d || '-') + '</span>';
                    } },
                    { data: null, orderable: false, searchable: false, render: function (data, t, r) {
                        return '<button class="btn btn-xs btn-warning" onclick="viewReturnDetail(' + data.id + ');"><i class="fa fa-list"></i></button>';
                    } }
                ],
                order: [[1, 'desc']]
            });
            loadReturns();
            reloadSales();
        });

        function loadReturns() {
            ajaxGet('/Returns/GetReturns', function (data) {
                var rows = data || [];
                var t = retTable;
                var s = t.fnSettings();
                t.fnClearTable(true);
                for (var i = 0; i < rows.length; i++) t.oApi._fnAddData(s, rows[i]);
                s.aiDisplay = s.aiDisplayMaster.slice();
                t.fnDraw();
            });
        }

        function reloadSales() {
            ajaxGet('/Sales/GetSales', function (data) {
                salesList = data || [];
                var sel = $('#retSale');
                var current = sel.val();
                sel.empty();
                sel.append('<option value="0">-- Select a sale --</option>');
                for (var i = 0; i < salesList.length; i++) {
                    var s = salesList[i];
                    sel.append('<option value="' + s.id + '">#' + s.sale_number + ' - ' + formatDate(s.created_on) + ' (' + (s.customer_name || 'Walk-In') + ')</option>');
                }
                if (current) sel.val(current);
            });
        }

        function openReturnModal() {
            resetReturnForm();
            $('#returnModal').modal('show');
        }

        function resetReturnForm() {
            $('#retSale').val('0');
            $('#retReason').val('Customer changed mind');
            $('#retItemsWrap').hide();
            $('#returnItemsTable tbody').empty();
            $('#retTotal').text('0.00');
            returnable = [];
        }

        function loadReturnable() {
            var saleId = $('#retSale').val();
            if (!saleId || saleId == '0') { resetReturnForm(); return; }
            ajaxGet('/Returns/GetReturnable?sale_id=' + saleId, function (data) {
                returnable = data || [];
                var body = $('#returnItemsTable tbody').empty();
                if (!returnable.length) {
                    $('#retItemsWrap').show();
                    body.html('<tr><td colspan="9" class="text-center">No items remaining to return on this sale.</td></tr>');
                    return;
                }
                for (var i = 0; i < returnable.length; i++) {
                    var it = returnable[i];
                    body.append(
                        '<tr recid="' + it.sale_item_id + '">' +
                            '<td><input type="checkbox" class="ret-item-chk" onchange="toggleLine(this);" /></td>' +
                            '<td>' + (it.product_name || '-') + '</td>' +
                            '<td>' + (it.sku || '-') + '</td>' +
                            '<td class="text-right">' + it.quantity + '</td>' +
                            '<td class="text-right">' + it.returned_qty + '</td>' +
                            '<td class="text-right r-remaining">' + it.remaining + '</td>' +
                            '<td class="text-right"><span class="r-price">' + it.unit_price + '</span></td>' +
                            '<td class="text-center"><input type="number" min="1" max="' + it.remaining + '" value="' + it.remaining + '" class="form-control input-sm text-right ret-qty" onchange="calcRefund();" onkeyup="calcRefund();" disabled /></td>' +
                            '<td><input type="number" min="0" step="0.5" value="0.00" class="form-control input-sm text-right ret-refund" onchange="calcRefund();" onkeyup="calcRefund();" disabled /></td>' +
                        '</tr>');
                }
                $('#retItemsWrap').show();
                calcRefund();
            }, function () { Swal.fire('Error', 'Could not load sale items.', 'error'); });
        }

        function toggleAll() {
            var all = $('#retSelAll').is(':checked');
            $('#returnItemsTable tbody tr').each(function () {
                if ($(this).find('.r-remaining').text() == '0') return;
                var chk = $(this).find('.ret-item-chk');
                chk.prop('checked', all ? true : chk.prop('checked'));
                toggleLine(chk[0]);
            });
            calcRefund();
        }

        function toggleLine(chk) {
            var tr = $(chk).closest('tr');
            var on = $(chk).is(':checked');
            tr.find('.ret-qty, .ret-refund').prop('disabled', !on);
            var refund = tr.find('.ret-refund');
            if (on && parseFloat(refund.val() || 0) <= 0)
                refund.val((parseFloat(tr.find('.ret-qty').val() || 0) * parseFloat(tr.find('.r-price').text() || 0)).toFixed(2));
            calcRefund();
        }

        function calcRefund() {
            var total = 0;
            $('#returnItemsTable tbody tr').each(function () {
                var chk = $(this).find('.ret-item-chk');
                if (!chk.is(':checked')) return;
                total += parseFloat($(this).find('.ret-refund').val() || 0);
            });
            $('#retTotal').text(fmt(total));
        }

        function saveReturn() {
            var saleId = parseInt($('#retSale').val());
            if (!saleId) { Swal.fire('Info', 'Select a sale first.', 'info'); return; }

            var items = [];
            var invalid = false;
            $('#returnItemsTable tbody tr').each(function () {
                var it = returnable[$(this).index()];
                var chk = $(this).find('.ret-item-chk');
                if (!chk.is(':checked')) return;
                var qty = parseInt($(this).find('.ret-qty').val() || 0);
                var remaining = parseInt($(this).find('.r-remaining').text());
                if (qty < 1 || qty > remaining) { invalid = true; return; }
                var refund = parseFloat($(this).find('.ret-refund').val() || 0);
                items.push({
                    sale_item_id: it.sale_item_id,
                    product_id: it.product_id,
                    batch_id: it.batch_id,
                    quantity: qty,
                    unit_price: parseFloat(it.unit_price || 0),
                    refund: parseFloat((refund > 0 ? refund : qty * it.unit_price).toFixed(2))
                });
            });

            if (!items.length) { Swal.fire('Info', 'Select at least one item to return.', 'info'); return; }
            if (invalid) { Swal.fire('Error', 'Return quantity exceeds what was sold.', 'error'); return; }

            var customerId = null;
            var sale = salesList.filter(function (s) { return parseInt(s.id) === saleId; })[0];
            if (sale && sale.customer_id != null && sale.customer_id > 0) customerId = sale.customer_id;

            Swal.fire({
                title: 'Record return?',
                text: items.length + ' item(s), refund KES ' + fmt(parseFloat($('#retTotal').text().replace(/,/g, ''))) + '. Stock will be restored. This can be reversed?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, record',
                cancelButtonText: 'Cancel'
            }).then(function (res) {
                if (!res.value) return;
                ajaxPost('/Returns/CreateReturn', {
                    sale_id: saleId,
                    customer_id: customerId,
                    reason: $('#retReason').val(),
                    items: items
                }, function (data) {
                    if (data && data.success) {
                        Swal.fire('Success', 'Return recorded. Stock restored.', 'success');
                        $('#returnModal').modal('hide');
                        loadReturns();
                        reloadSales();
                    } else {
                        Swal.fire('Error', (data && data.message) || 'Failed to record return', 'error');
                    }
                });
            });
        }

        function viewReturnDetail(id) {
            ajaxGet('/Returns/GetReturnDetail?return_id=' + id, function (data) {
                var rows = data || [];
                var lines = rows.map(function (r) {
                    return '<tr><td>' + (r.product_name || '-') + '</td><td>' + (r.sku || '-') + '</td><td class="text-right">' + r.quantity + '</td><td class="text-right">KES ' + fmt(r.unit_price) + '</td><td class="text-right">KES ' + fmt(r.refund_amount) + '</td></tr>';
                }).join('');
                Swal.fire({
                    title: 'Return items',
                    html: '<table class="table table-bordered table-condensed">' +
                        '<thead><tr><th>Product</th><th>SKU</th><th class="text-right">Qty</th><th class="text-right">Unit Price</th><th class="text-right">Refund</th></tr></thead>' +
                        '<tbody>' + (lines || '<tr><td colspan="5">No items found.</td></tr>') + '</tbody></table>',
                    confirmButtonText: 'Close'
                });
            });
        }

        function fmt(v) { return parseFloat(v || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
        function formatDate(d) {
            if (!d) return '-';
            return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        }
    </script>
}