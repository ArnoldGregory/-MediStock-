@model MediStock.Portal.Models.Auth.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>MediStock — Sign In</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content="MediStock Pharmaceutical Inventory Management System" />
    <link rel="shortcut icon" type="image/png" href="~/assets/static/img/favicon.ico" />

    <link href="~/assets/static/plugins/jquery-ui/themes/base/minified/jquery-ui.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/assets/static/css/animate.min.css" rel="stylesheet" />
    <link href="~/assets/static/css/style.min.css" rel="stylesheet" />
    <link href="~/assets/static/css/style-responsive.min.css" rel="stylesheet" />
    <link href="~/assets/static/css/theme/default.css" rel="stylesheet" id="theme" />
    <style>
        .login.login-with-news-feed {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }
        .login .news-feed {
            width: 50%;
            min-height: 100vh;
            overflow: hidden;
            position: relative;
        }
        .login .news-feed .news-image {
            width: 100%;
            height: 100%;
        }
        .login .news-feed .news-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            display: block;
        }
        .login .right-content {
            width: 50%;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
        }
        .login .right-content .login-content {
            width: 100%;
            max-width: 400px;
            padding: 30px 40px;
        }
        .login-content .madison-logo {
            display: block;
            max-width: 160px;
            margin: 0 auto 10px;
        }
        .login-brand-text h1 {
            font-size: 1.8rem;
            font-weight: 700;
            margin: 10px 0 4px;
        }
        .login-brand-text p {
            color: #999;
            font-size: 0.85rem;
            margin-bottom: 25px;
        }
        .feature-list {
            list-style: none;
            padding: 0;
            margin: 20px 0 0;
        }
        .feature-list li {
            padding: 6px 0;
            font-size: 0.82rem;
            color: #666;
        }
        .feature-list li i {
            color: #2ecc71;
            margin-right: 8px;
            width: 16px;
            text-align: center;
        }
        .login-buttons .btn {
            padding: 10px;
            font-size: 0.95rem;
        }
        .login-content .form-group label {
            font-weight: 600;
            font-size: 0.85rem;
            color: #333;
        }
        .login-content .form-control.input-lg {
            height: 46px;
            font-size: 0.95rem;
            border-radius: 6px;
        }
        @@media (max-width: 992px) {
            .login.login-with-news-feed {
                flex-direction: column;
            }
            .login .news-feed,
            .login .right-content {
                width: 100%;
                min-height: auto;
            }
            .login .news-feed {
                height: 250px;
            }
        }
    </style>
</head>
<body class="pace-top bg-white">
    <div id="page-loader" class="fade in"><span class="spinner"></span></div>

    <div id="page-container" class="fade">
        <div class="login login-with-news-feed">
            <!-- LEFT PANEL — Cover Image -->
            <div class="news-feed">
                <div class="news-image">
                    <img src="~/images/pexels-tara-winstead-7722640.jpg" alt="MediStock" />
                </div>
            </div>

            <!-- RIGHT PANEL — Login Form -->
            <div class="right-content">
                <div class="login-content">
                    <div class="login-brand-text text-center">
                        <h1><strong style="color:#2ecc71;">Medi</strong><strong style="color:#3498db;">Stock</strong></h1>
                        <p>Pharmaceutical Inventory Management</p>
                    </div>

                    <form asp-controller="Account" asp-action="Login" method="POST" class="margin-bottom-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                        <div class="row" id="errors">
                            @if (!string.IsNullOrEmpty(ViewBag.ExpiredMessage as string))
                            {
                                <div class="alert alert-info">@ViewBag.ExpiredMessage</div>
                            }
                            @if (!string.IsNullOrEmpty(Model.errormessage))
                            {
                                <div class="alert alert-danger">@Model.errormessage</div>
                            }
                        </div>

                        <div class="form-group m-b-15">
                            <label for="pharmacySlug">Pharmacy <span style="color:red;">*</span></label>
                            <input type="text" id="pharmacySlug" name="pharmacySlug" value="@Model?.pharmacySlug" class="form-control input-lg" placeholder="Enter pharmacy slug or code" required />
                        </div>
                        <div class="form-group m-b-15">
                            <label for="email">Email Address <span style="color:red;">*</span></label>
                            <input type="text" id="email" name="username" value="@Model?.username" class="form-control input-lg" placeholder="Email Address" required />
                        </div>
                        <div class="form-group has-feedback">
                            <label for="password">Password <span style="color:red;">*</span></label>
                            <input type="password" id="password" name="password" class="form-control input-lg" placeholder="Password" required />
                        </div>

                        <div class="checkbox m-b-30"></div>

                        <div class="login-buttons">
                            <div class="form-group">
                                <a href="@Url.Action("ResetPassword", "Account")" title="Forgot your password?">Forgot your password?</a>
                            </div>
                            <button id="login" name="login" type="submit" class="btn btn-primary btn-block btn-sm">
                                <i class="fa fa-sign-in"></i> Sign In
                            </button>
                        </div>

                        <hr />

                        <ul class="feature-list">
                            <li><i class="fa fa-check-circle"></i> Real-time inventory tracking</li>
                            <li><i class="fa fa-check-circle"></i> POS &amp; wholesale management</li>
                            <li><i class="fa fa-check-circle"></i> DDA &amp; controlled substance compliance</li>
                            <li><i class="fa fa-check-circle"></i> Supplier &amp; purchase order management</li>
                        </ul>

                        <hr />
                        <p class="text-center">
                            Copyright &copy; @DateTime.Now.Year <strong>MediStock</strong> &mdash; Pharmaceutical Management System
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/assets/static/plugins/jquery/jquery-1.9.1.min.js"></script>
    <script src="~/assets/static/plugins/jquery/jquery-migrate-1.1.0.min.js"></script>
    <script src="~/assets/static/plugins/jquery-ui/ui/minified/jquery-ui.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/slimscroll/jquery.slimscroll.min.js"></script>
    <script src="~/assets/static/plugins/jquery-cookie/jquery.cookie.js"></script>
    <script src="~/assets/static/js/apps.min.js"></script>
    <script src="~/assets/static/js/jquery.blockUI.js"></script>
    <script>
        $(document).ready(function () {
            App.init();
            $('#page-loader').addClass('hide');
        });
        $(document).on('submit', 'form', function (e) {
            if ($('form')[0].checkValidity()) {
                if (!e.isDefaultPrevented()) {
                    $.blockUI({ message: '<h4><i class="fa fa-spinner fa-spin"></i> Please wait...</h4>' });
                }
            }
        });
    </script>
</body>
</html>
