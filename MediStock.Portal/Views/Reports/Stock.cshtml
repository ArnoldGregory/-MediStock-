@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-cubes"></i> Stock Report <small>Inventory</small></h1>

<!-- Summary Cards -->
<div class="row">
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-green">
            <div class="stats-icon"><i class="fa fa-pills"></i></div>
            <div class="stats-info"><h4>TOTAL PRODUCTS</h4><p id="rptTotalProducts">-</p></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-blue">
            <div class="stats-icon"><i class="fa fa-cubes"></i></div>
            <div class="stats-info"><h4>STOCK VALUE</h4><p id="rptStockValue">-</p></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-orange">
            <div class="stats-icon"><i class="fa fa-exclamation-triangle"></i></div>
            <div class="stats-info"><h4>LOW STOCK</h4><p id="rptLowStock">-</p></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-red">
            <div class="stats-icon"><i class="fa fa-clock-o"></i></div>
            <div class="stats-info"><h4>EXPIRING SOON</h4><p id="rptExpiring">-</p></div>
        </div>
    </div>
</div>

<!-- Stock by Category -->
<div class="row m-t-20">
    <div class="col-md-6">
        <div class="panel panel-inverse">
            <div class="panel-heading"><h4 class="panel-title" style="color:#fff;"><i class="fa fa-bar-chart m-r-5"></i> Stock by Category</h4></div>
            <div class="panel-body"><div id="categoryChart" style="height:300px;"><i class="fa fa-spinner fa-spin"></i> Loading...</div></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-inverse">
            <div class="panel-heading"><h4 class="panel-title" style="color:#fff;"><i class="fa fa-exclamation-circle m-r-5"></i> Low Stock Items</h4></div>
            <div class="panel-body"><div id="lowStockList"><i class="fa fa-spinner fa-spin"></i> Loading...</div></div>
        </div>
    </div>
</div>

<!-- Full Stock Table -->
<div class="row m-t-20">
    <div class="col-md-12">
        <div class="panel panel-inverse">
            <div class="panel-heading">
                <h4 class="panel-title" style="color:#fff;"><i class="fa fa-table m-r-5"></i> Full Stock Report</h4>
            </div>
            <div class="panel-body">
                <div class="row m-b-10">
                    <div class="col-md-12">
                        <button class="btn btn-sm btn-default" onclick="window.print();"><i class="fa fa-print"></i> Print</button>
                        <button class="btn btn-sm btn-default" onclick="exportStock();"><i class="fa fa-download"></i> Export CSV</button>
                    </div>
                </div>
                <table id="stockReportTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Form</th>
                            <th>Current Stock</th>
                            <th>Reorder Level</th>
                            <th>Stock Value</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script>
        $(document).ready(function () {
            loadStockReport();
            loadSummary();
        });

        function loadSummary() {
            $.get('/api/reports/stock/summary', function (data) {
                $('#rptTotalProducts').text(data.totalProducts || 0);
                $('#rptStockValue').text('KES ' + parseFloat(data.stockValue || 0).toFixed(2));
                $('#rptLowStock').text(data.lowStockCount || 0);
                $('#rptExpiring').text(data.expiringSoonCount || 0);
            });

            $.get('/api/reports/stock/low-stock', function (data) {
                var html = '<table class="table table-condensed"><thead><tr><th>Product</th><th>Stock</th><th>Reorder</th></tr></thead><tbody>';
                if (data && data.length) {
                    $.each(data, function (i, item) {
                        var cls = item.currentStock === 0 ? 'text-danger font-bold' : 'text-warning';
                        html += '<tr class="' + cls + '"><td>' + item.productName + '</td><td>' + item.currentStock + '</td><td>' + item.reorderLevel + '</td></tr>';
                    });
                } else {
                    html += '<tr><td colspan="3" class="text-muted">All stock levels OK</td></tr>';
                }
                html += '</tbody></table>';
                $('#lowStockList').html(html);
            });
        }

        function loadStockReport() {
            $('#stockReportTable').DataTable({
                ajax: { url: '/api/reports/stock', dataSrc: '' },
                columns: [
                    { data: 'productCode' },
                    { data: 'productName' },
                    { data: 'categoryName' },
                    { data: 'dosageForm' },
                    { data: 'currentStock' },
                    { data: 'reorderLevel' },
                    { data: 'stockValue', render: function (d) { return 'KES ' + parseFloat(d).toFixed(2); } },
                    { data: null, render: function (d) {
                        if (d.currentStock === 0) return '<span class="label label-danger">Out of Stock</span>';
                        if (d.currentStock <= d.reorderLevel) return '<span class="label label-warning">Low Stock</span>';
                        return '<span class="label label-success">OK</span>';
                    }}
                ],
                order: [[5, 'asc']]
            });
        }

        function exportStock() {
            window.location.href = '/api/reports/stock/export';
        }
    </script>
}
