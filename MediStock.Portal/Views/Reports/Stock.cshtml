@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-cubes"></i> Stock Report <small>Inventory Valuation</small></h1>

<!-- Summary Cards -->
<div class="row">
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-green">
            <div class="stats-icon"><i class="fa fa-pills"></i></div>
            <div class="stats-info"><h4>TOTAL PRODUCTS</h4><p id="rptTotalProducts">-</p></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-blue">
            <div class="stats-icon"><i class="fa fa-cubes"></i></div>
            <div class="stats-info"><h4>STOCK VALUE</h4><p id="rptStockValue">-</p></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-purple">
            <div class="stats-icon"><i class="fa fa-line-chart"></i></div>
            <div class="stats-info"><h4>RETAIL VALUE</h4><p id="rptRetailValue">-</p></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-orange">
            <div class="stats-icon"><i class="fa fa-exclamation-triangle"></i></div>
            <div class="stats-info"><h4>LOW STOCK</h4><p id="rptLowStock">-</p></div>
        </div>
    </div>
</div>

<!-- Full Stock Table -->
<div class="row m-t-20">
    <div class="col-md-12">
        <div class="panel panel-inverse">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <button type="button" class="btn btn-xs btn-success" onclick="LoadStockReport();"><i class="fa fa-repeat"></i></button>
                </div>
                <h4 class="panel-title" style="color:#fff;"><i class="fa fa-table m-r-5"></i> Full Stock Report</h4>
            </div>
            <div class="panel-body">
                <div class="row m-b-10">
                    <div class="col-md-12">
                        <button class="btn btn-sm btn-default" onclick="window.print();"><i class="fa fa-print"></i> Print</button>
                        <button class="btn btn-sm btn-default" onclick="ExportCsv();"><i class="fa fa-download"></i> Export CSV</button>
                        <button class="btn btn-sm btn-success" onclick="ExportExcel();"><i class="fa fa-file-excel-o"></i> Export Excel</button>
                    </div>
                </div>
                <table id="stockReportTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>SKU</th>
                            <th>Category</th>
                            <th>Current Stock</th>
                            <th>Reorder Level</th>
                            <th>Stock Value</th>
                            <th>Retail Value</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        var _stockReport;
        var stockAll = [];

        $(document).ready(function () {
            _stockReport = $('#stockReportTable').dataTable({
                responsive: true,
                createdRow: function (row, data) { $(row).attr('recid', data.name); },
                aoColumns: [
                    { data: 'name',           autoWidth: true, sDefaultContent: '—' },
                    { data: 'sku',            autoWidth: true, sDefaultContent: '—' },
                    { data: 'category_name',  autoWidth: true, sDefaultContent: '—' },
                    { data: 'stock_qty',      autoWidth: true, sDefaultContent: '0' },
                    { data: 'reorder_level',  autoWidth: true, sDefaultContent: '0' },
                    { data: 'stock_value',    autoWidth: true, sDefaultContent: '0', render: function (d) { return 'KES ' + fmt(d); } },
                    { data: 'retail_value',   autoWidth: true, sDefaultContent: '0', render: function (d) { return 'KES ' + fmt(d); } },
                    { data: null,             autoWidth: true, sDefaultContent: '—', render: function (d) { return stockLabel(d.stock_qty, d.reorder_level); } }
                ],
                order: [[0, 'asc']],
                pageLength: 25
            });
            LoadStockReport();
        });

        function LoadStockReport() {
            ajaxGet('/Reports/GetStockReport', function (data) {
                stockAll = data || [];

                var total = 0, value = 0, retail = 0, low = 0;
                for (var i = 0; i < stockAll.length; i++) {
                    total++;
                    value += parseFloat(stockAll[i].stock_value || 0);
                    retail += parseFloat(stockAll[i].retail_value || 0);
                    if (parseInt(stockAll[i].stock_qty || 0) <= parseInt(stockAll[i].reorder_level || 0)) low++;
                }
                $('#rptTotalProducts').text(total);
                $('#rptStockValue').text('KES ' + fmt(value));
                $('#rptRetailValue').text('KES ' + fmt(retail));
                $('#rptLowStock').text(low);

                var t = _stockReport;
                var s = t.fnSettings();
                t.fnClearTable(true);
                for (var j = 0; j < stockAll.length; j++) t.oApi._fnAddData(s, stockAll[j]);
                s.aiDisplay = s.aiDisplayMaster.slice();
                t.fnDraw();
            });
        }

        function stockLabel(qty, reorder) {
            var q = parseInt(qty || 0), r = parseInt(reorder || 0);
            if (q === 0) return '<span class="label label-danger">Out of Stock</span>';
            if (q <= r) return '<span class="label label-warning">Low Stock</span>';
            return '<span class="label label-success">OK</span>';
        }

        function ExportCsv() {
            if (!stockAll.length) { Swal.fire('Info', 'No stock data to export.', 'info'); return; }
            var rows = [['Product', 'SKU', 'Category', 'Current Stock', 'Reorder Level', 'Stock Value', 'Retail Value', 'Status']];
            for (var i = 0; i < stockAll.length; i++) {
                var r = stockAll[i];
                rows.push([r.name || '', r.sku || '', r.category_name || '', r.stock_qty, r.reorder_level,
                           r.stock_value, r.retail_value,
                           r.stock_qty === 0 ? 'Out of Stock' : (r.stock_qty <= r.reorder_level ? 'Low Stock' : 'OK')]);
            }
            downloadCsv('stock_report.csv', rows);
        }

        function ExportExcel() {
            window.location.href = '/Reports/ExportExcel?report=stock';
        }

        function downloadCsv(fileName, rows) {
            var csv = rows.map(function (r) {
                return r.map(function (c) {
                    if (c === null || c === undefined) return '';
                    return '"' + String(c).replace(/"/g, '""') + '"';
                }).join(',');
            }).join('\n');
            var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function fmt(v) { return parseFloat(v || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
    </script>
}