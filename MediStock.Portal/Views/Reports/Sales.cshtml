@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-bar-chart"></i> Sales Report <small>Daily Summary</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <h4 class="panel-title"><i class="fa fa-filter"></i> Report Filters</h4>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>From</label>
                    <input type="text" class="form-control date-picker" id="dateFrom" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>To</label>
                    <input type="text" class="form-control date-picker" id="dateTo" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>&nbsp;</label>
                    <div>
                        <button class="btn btn-primary" onclick="GenerateReport();"><i class="fa fa-cog"></i> Generate</button>
                        <button class="btn btn-default" onclick="window.print();"><i class="fa fa-print"></i> Print</button>
                        <button class="btn btn-default" onclick="ExportCsv();"><i class="fa fa-download"></i> Export CSV</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row" id="summaryCards" style="display:none;">
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-green">
            <div class="stats-icon"><i class="fa fa-money"></i></div>
            <div class="stats-info"><h4>TOTAL SALES</h4><p id="rptTotalSales">-</p></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-blue">
            <div class="stats-icon"><i class="fa fa-shopping-cart"></i></div>
            <div class="stats-info"><h4>TRANSACTIONS</h4><p id="rptTransactions">-</p></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-orange">
            <div class="stats-icon"><i class="fa fa-calculator"></i></div>
            <div class="stats-info"><h4>VAT COLLECTED</h4><p id="rptVat">-</p></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-purple">
            <div class="stats-icon"><i class="fa fa-tag"></i></div>
            <div class="stats-info"><h4>DISCOUNTS GIVEN</h4><p id="rptDiscounts">-</p></div>
        </div>
    </div>
</div>

<!-- Details Table -->
<div class="row m-t-20" id="detailRow" style="display:none;">
    <div class="col-md-12">
        <div class="panel panel-inverse">
            <div class="panel-heading">
                <div class="panel-heading-btn">
                    <button type="button" class="btn btn-xs btn-success" onclick="GenerateReport();"><i class="fa fa-repeat"></i></button>
                </div>
                <h4 class="panel-title" style="color:#fff;"><i class="fa fa-table m-r-5"></i> Daily Sales Summary</h4>
            </div>
            <div class="panel-body">
                <table id="salesReportTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Transactions</th>
                            <th>Total Sales</th>
                            <th>VAT</th>
                            <th>Discounts</th>
                            <th>Profit</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        var _salesReport;
        var salesAll = [];

        $(document).ready(function () {
            _salesReport = $('#salesReportTable').dataTable({
                responsive: true,
                createdRow: function (row, data) { $(row).attr('recid', data.sale_date); },
                aoColumns: [
                    { data: 'sale_date',     autoWidth: true, sDefaultContent: '—', render: function (d) { return formatDate(d); } },
                    { data: 'transactions',  autoWidth: true, sDefaultContent: '0' },
                    { data: 'total_sales',   autoWidth: true, sDefaultContent: '0', render: function (d) { return 'KES ' + fmt(d); } },
                    { data: 'vat_total',     autoWidth: true, sDefaultContent: '0', render: function (d) { return 'KES ' + fmt(d); } },
                    { data: 'discounts',     autoWidth: true, sDefaultContent: '0', render: function (d) { return 'KES ' + fmt(d); } },
                    { data: 'profit',        autoWidth: true, sDefaultContent: '0', render: function (d) { return '<strong>KES ' + fmt(d) + '</strong>'; } }
                ],
                order: [[0, 'desc']],
                pageLength: 25
            });
            $('.date-picker').datepicker({ autoclose: true, todayHighlight: true, format: 'yyyy-mm-dd' });
        });

        function GenerateReport() {
            var qs = '/Reports/GetSalesReport?';
            if ($('#dateFrom').val()) qs += 'from_date=' + encodeURIComponent($('#dateFrom').val()) + '&';
            if ($('#dateTo').val()) qs += 'to_date=' + encodeURIComponent($('#dateTo').val());

            ajaxGet(qs, function (data) {
                salesAll = data || [];

                $('#summaryCards, #detailRow').show();
                var total = 0, txn = 0, vat = 0, disc = 0;
                for (var i = 0; i < salesAll.length; i++) {
                    total += parseFloat(salesAll[i].total_sales || 0);
                    txn += parseInt(salesAll[i].transactions || 0);
                    vat += parseFloat(salesAll[i].vat_total || 0);
                    disc += parseFloat(salesAll[i].discounts || 0);
                }
                $('#rptTotalSales').text('KES ' + fmt(total));
                $('#rptTransactions').text(txn);
                $('#rptVat').text('KES ' + fmt(vat));
                $('#rptDiscounts').text('KES ' + fmt(disc));

                var t = _salesReport;
                var s = t.fnSettings();
                t.fnClearTable(true);
                for (var j = 0; j < salesAll.length; j++) t.oApi._fnAddData(s, salesAll[j]);
                s.aiDisplay = s.aiDisplayMaster.slice();
                t.fnDraw();
            });
        }

        function ExportCsv() {
            if (!salesAll.length) { Swal.fire('Info', 'Generate report first.', 'info'); return; }
            var rows = [['Date', 'Transactions', 'Total Sales', 'VAT', 'Discounts', 'Profit']];
            for (var i = 0; i < salesAll.length; i++) {
                var r = salesAll[i];
                rows.push([(r.sale_date || ''), r.transactions, r.total_sales, r.vat_total, r.discounts, r.profit]);
            }
            downloadCsv('sales_report.csv', rows);
        }

        function downloadCsv(fileName, rows) {
            var csv = rows.map(function (r) {
                return r.map(function (c) {
                    if (c === null || c === undefined) return '';
                    return '"' + String(c).replace(/"/g, '""') + '"';
                }).join(',');
            }).join('\n');
            var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function fmt(v) { return parseFloat(v || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
        function formatDate(d) {
            if (!d) return '—';
            return new Date(d.indexOf('T') > -1 ? d : d + 'T00:00:00').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        }
    </script>
}