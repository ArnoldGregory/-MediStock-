@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-clipboard"></i> Stock Take <small>Inventory Count</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <button type="button" class="btn btn-xs btn-success" onclick="LoadSessions();"><i class="fa fa-repeat"></i></button>
        </div>
        <h4 class="panel-title">Stock Take Sessions</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-12">
                <button class="btn btn-sm btn-success" data-toggle="modal" data-target="#startModal">
                    <i class="fa fa-plus"></i> Start New Stock Take
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="stockTakeTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Session</th>
                            <th>Started On</th>
                            <th>Committed On</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Start Stock Take Modal -->
<div class="modal fade" id="startModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                <h4 class="modal-title"><i class="fa fa-clipboard"></i> Start Stock Take</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Session Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="stSessionName" placeholder="e.g. Monthly count Aug 2026" />
                </div>
                <hr />
                <div class="form-inline m-b-10">
                    <div class="form-group m-r-10">
                        <select class="form-control" id="stProduct" style="min-width:300px;">
                            <option value="">-- Select Product --</option>
                        </select>
                    </div>
                    <div class="form-group m-r-10">
                        <input type="number" class="form-control" id="stCountedQty" min="0" placeholder="Counted Qty" style="width:120px;" />
                    </div>
                    <div class="form-group m-r-10">
                        <input type="text" class="form-control" id="stNotes" placeholder="Notes (optional)" style="width:200px;" />
                    </div>
                    <button type="button" class="btn btn-sm btn-info" onclick="AddCountItem();"><i class="fa fa-plus"></i> Add Item</button>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <table class="table table-bordered table-condensed" id="stItemsTable">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>System Qty</th>
                                    <th>Counted Qty</th>
                                    <th>Variance</th>
                                    <th>Notes</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="btn btn-success" id="btnSaveStockTake"><i class="fa fa-save"></i> Save &amp; Commit</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        var _stTable;
        var countItems = [];
        var productLookup = {};

        $(document).ready(function () {
            _stTable = InitSessionTable();
            LoadSessions();
            LoadCountProducts();
        });

        function InitSessionTable() {
            return $('#stockTakeTable').dataTable({
                responsive: true,
                createdRow: function (row, data) { $(row).attr('recid', data.id); },
                aoColumns: [
                    { data: 'session_name', autoWidth: true, sDefaultContent: '—' },
                    { data: 'started_on',   autoWidth: true, sDefaultContent: '—', render: function (d) { return formatDate(d); } },
                    { data: 'committed_on', autoWidth: true, sDefaultContent: '—', render: function (d) { return d ? formatDate(d) : '—'; } },
                    { data: 'status',       autoWidth: true, render: function (d) {
                        if (d === 'Open') return '<span class="label label-warning">Open</span>';
                        if (d === 'Committed') return '<span class="label label-success">Committed</span>';
                        return '<span class="label label-default">' + (d || '—') + '</span>';
                    } }
                ],
                order: [[1, 'desc']]
            });
        }

        function LoadSessions() {
            ajaxGet('/Stock/GetStockTake', function (data) {
                var t = _stTable;
                var s = t.fnSettings();
                t.fnClearTable(true);
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) t.oApi._fnAddData(s, data[i]);
                }
                s.aiDisplay = s.aiDisplayMaster.slice();
                t.fnDraw();
            });
        }

        function LoadCountProducts() {
            ajaxGet('/Products/GetProducts', function (data) {
                var $sel = $('#stProduct');
                var opts = ['<option value="">-- Select Product --</option>'];
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) {
                        productLookup[data[i].id] = data[i];
                        opts.push('<option value="' + data[i].id + '">' + data[i].name + ' (System: ' + data[i].stock_qty + ')</option>');
                    }
                }
                $sel.html(opts.join(''));
            });
        }

        function AddCountItem() {
            var pid = parseInt($('#stProduct').val()) || 0;
            var counted = parseInt($('#stCountedQty').val());
            if (isNaN(counted)) counted = 0;
            var notes = $('#stNotes').val().trim();

            if (!pid) { Swal.fire('Validation', 'Select a product.', 'warning'); return; }

            var existing = countItems.filter(function (i) { return i.product_id === pid; });
            if (existing.length) { Swal.fire('Warning', 'Product already counted; remove and re-add to change.', 'warning'); return; }

            var p = productLookup[pid];
            countItems.push({ product_id: pid, batch_id: 0, system_qty: parseInt(p.stock_qty) || 0, counted_qty: counted, notes: notes });
            RenderCountItems();
            $('#stProduct').val('').trigger('change');
            $('#stCountedQty').val('');
            $('#stNotes').val('');
        }

        function RemoveCountItem(pid) {
            countItems = countItems.filter(function (i) { return i.product_id !== pid; });
            RenderCountItems();
        }

        function RenderCountItems() {
            var rows = [];
            for (var i = 0; i < countItems.length; i++) {
                var it = countItems[i];
                var p = productLookup[it.product_id];
                rows.push(
                    '<tr>' +
                        '<td>' + (p ? p.name : ('#' + it.product_id)) + '</td>' +
                        '<td>' + it.system_qty + '</td>' +
                        '<td>' + it.counted_qty + '</td>' +
                        '<td>' + (it.counted_qty - it.system_qty) + '</td>' +
                        '<td>' + (it.notes || '—') + '</td>' +
                        '<td><button type="button" class="btn btn-xs btn-danger" onclick="RemoveCountItem(' + it.product_id + ');"><i class="fa fa-trash"></i></button></td>' +
                    '</tr>'
                );
            }
            $('#stItemsTable tbody').html(rows.join(''));
        }

        function formatDate(d) {
            if (!d) return '—';
            return new Date(d.indexOf('T') > -1 ? d : d + 'T00:00:00').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        }

        $('#startModal').on('hidden.bs.modal', function () {
            $('#stSessionName').val('');
            countItems = [];
            RenderCountItems();
        });

        $('#btnSaveStockTake').on('click', function () {
            var sessionName = $('#stSessionName').val().trim();
            if (!sessionName) { Swal.fire('Validation', 'Session name is required.', 'warning'); return; }
            if (!countItems.length) { Swal.fire('Validation', 'Add at least one counted item.', 'warning'); return; }

            var btn = this;
            btnLoad(btn, 'Saving...');
            ajaxPost('/Stock/SaveStockTake', {
                session_name: sessionName,
                items: countItems
            }, function (res) {
                btnStop(btn);
                if (res.success) {
                    $('#startModal').modal('hide');
                    LoadSessions();
                    Swal.fire('Saved', res.message, 'success');
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            }, function () { btnStop(btn); Swal.fire('Error', 'Request failed.', 'error'); });
        });
    </script>
}