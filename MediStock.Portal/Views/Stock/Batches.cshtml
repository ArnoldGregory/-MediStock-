@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-cubes"></i> Batches <small>Expiry Tracking</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("Batches", "Stock")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
        </div>
        <h4 class="panel-title">Stock Batches</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-8">
                <div class="btn-group">
                    <a href="#" class="btn btn-sm btn-default" onclick="filterBatches('all');">All</a>
                    <a href="#" class="btn btn-sm btn-danger" onclick="filterBatches('expired');">Expired</a>
                    <a href="#" class="btn btn-sm btn-warning" onclick="filterBatches('expiring30');">Expiring &lt; 30 Days</a>
                    <a href="#" class="btn btn-sm btn-info" onclick="filterBatches('expiring90');">Expiring &lt; 90 Days</a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="batchesTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Batch No</th>
                            <th>Quantity</th>
                            <th>Cost Price</th>
                            <th>Expiry Date</th>
                            <th>Supplier</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        var table;
        $(document).ready(function () {
            loadBatches();
        });

        function loadBatches(status) {
            if (table) table.destroy();
            var url = status && status !== 'all' ? '/api/stock/batches?status=' + status : '/api/stock/batches';

            table = $('#batchesTable').DataTable({
                ajax: { url: url, dataSrc: '' },
                columns: [
                    { data: 'productName' },
                    { data: 'batchNumber' },
                    { data: 'quantity' },
                    { data: 'costPrice', render: function (d) { return 'KES ' + parseFloat(d).toFixed(2); } },
                    { data: 'expiryDate', render: function (d) { return formatDate(d); } },
                    { data: 'supplierName', defaultContent: '-' },
                    { data: null, render: function (data) {
                        var expDate = new Date(data.expiryDate);
                        var now = new Date();
                        var diffDays = Math.floor((expDate - now) / (1000 * 60 * 60 * 24));
                        if (diffDays < 0) return '<span class="label label-danger">Expired</span>';
                        if (diffDays <= 30) return '<span class="label label-warning">' + diffDays + ' days</span>';
                        if (diffDays <= 90) return '<span class="label label-info">' + diffDays + ' days</span>';
                        return '<span class="label label-success">OK</span>';
                    }},
                    { data: null, orderable: false, searchable: false, render: function (data) {
                        return '<a href="/Stock/BatchDetail/' + data.batchId + '" class="btn btn-xs btn-info"><i class="fa fa-eye"></i></a>';
                    }}
                ],
                order: [[4, 'asc']]
            });
        }

        function filterBatches(status) { loadBatches(status); }

        function formatDate(d) {
            if (!d) return '-';
            var dt = new Date(d);
            return dt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        }
    </script>
}
