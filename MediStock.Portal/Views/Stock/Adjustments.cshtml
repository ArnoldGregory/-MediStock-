@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-sliders"></i> Stock Adjustments <small>Inventory</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("Adjustments", "Stock")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
        </div>
        <h4 class="panel-title">Stock Adjustments</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-12">
                <button class="btn btn-sm btn-success" data-toggle="modal" data-target="#adjustmentModal">
                    <i class="fa fa-plus"></i> New Adjustment
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="adjustmentsTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Product</th>
                            <th>Batch</th>
                            <th>Type</th>
                            <th>Quantity</th>
                            <th>Reason</th>
                            <th>Adjusted By</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Adjustment Modal -->
<div class="modal fade" id="adjustmentModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-controller="Stock" asp-action="SaveAdjustment" method="POST" id="adjustmentForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    <h4 class="modal-title"><i class="fa fa-sliders"></i> New Stock Adjustment</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Product <span class="text-danger">*</span></label>
                                <select class="form-control select2" id="adjProductId" name="productId" required>
                                    <option value="">-- Select Product --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Batch <span class="text-danger">*</span></label>
                                <select class="form-control" id="adjBatchId" name="batchId" required>
                                    <option value="">-- Select Product First --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Adjustment Type <span class="text-danger">*</span></label>
                                <select class="form-control" id="adjType" name="adjustmentType" required>
                                    <option value="Addition">Addition (Stock In)</option>
                                    <option value="Reduction">Reduction (Stock Out)</option>
                                    <option value="WriteOff">Write Off</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Quantity <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="adjQuantity" name="quantity" min="1" required />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="adjReason" name="reason" rows="3" placeholder="e.g. Physical count correction, damaged goods, etc." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save Adjustment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/assets/static/plugins/select2/dist/js/select2.full.min.js"></script>
    <script>
        var table;
        $(document).ready(function () {
            $('.select2').select2({ width: '100%' });
            loadAdjustments();
            loadProducts();

            $('#adjProductId').on('change', function () {
                var pid = $(this).val();
                if (pid) {
                    $.get('/api/stock/batches?productId=' + pid, function (data) {
                        var $sel = $('#adjBatchId');
                        $sel.empty().append('<option value="">-- Select Batch --</option>');
                        $.each(data, function (i, item) {
                            $sel.append('<option value="' + item.batchId + '">' + item.batchNumber + ' (Qty: ' + item.quantity + ')</option>');
                        });
                    });
                } else {
                    $('#adjBatchId').empty().append('<option value="">-- Select Product First --</option>');
                }
            });
        });

        function loadAdjustments() {
            table = $('#adjustmentsTable').DataTable({
                ajax: { url: '/api/stock/adjustments', dataSrc: '' },
                columns: [
                    { data: 'adjustmentDate', render: function (d) { return formatDate(d); } },
                    { data: 'productName' },
                    { data: 'batchNumber' },
                    { data: 'adjustmentType', render: function (d) {
                        if (d === 'Addition') return '<span class="label label-success">Addition</span>';
                        if (d === 'Reduction') return '<span class="label label-warning">Reduction</span>';
                        return '<span class="label label-danger">Write Off</span>';
                    }},
                    { data: 'quantity' },
                    { data: 'reason' },
                    { data: 'adjustedByName' }
                ],
                order: [[0, 'desc']]
            });
        }

        function loadProducts() {
            $.get('/api/products', function (data) {
                var $sel = $('#adjProductId');
                $sel.empty().append('<option value="">-- Select Product --</option>');
                $.each(data, function (i, item) {
                    $sel.append('<option value="' + item.productId + '">' + item.productName + '</option>');
                });
            });
        }

        function formatDate(d) {
            if (!d) return '-';
            return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        }

        $('#adjustmentForm').on('submit', function (e) {
            e.preventDefault();
            $.ajax({
                url: '/api/stock/adjustments',
                type: 'POST',
                data: $(this).serialize(),
                success: function () {
                    Swal.fire('Saved', 'Adjustment recorded successfully.', 'success');
                    $('#adjustmentModal').modal('hide');
                    table.ajax.reload();
                    $('#adjustmentForm')[0].reset();
                    $('.select2').val(null).trigger('change');
                },
                error: function (xhr) {
                    Swal.fire('Error', xhr.responseText || 'Unable to save adjustment.', 'error');
                }
            });
        });
    </script>
}
