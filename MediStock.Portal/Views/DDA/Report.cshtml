@section PageStyles {
    <link href="~/assets/static/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-shield"></i> DDA Compliance Report <small>Controlled Substances</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <h4 class="panel-title"><i class="fa fa-filter"></i> Report Period</h4>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-3">
                <label>From</label>
                <input type="text" class="form-control date-picker" id="dateFrom" />
            </div>
            <div class="col-md-3">
                <label>To</label>
                <input type="text" class="form-control date-picker" id="dateTo" />
            </div>
            <div class="col-md-3">
                <label>&nbsp;</label>
                <div>
                    <button class="btn btn-primary" onclick="generateReport();"><i class="fa fa-cog"></i> Generate</button>
                    <button class="btn btn-default" onclick="window.print();"><i class="fa fa-print"></i> Print</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Summary -->
<div class="row" id="summaryRow" style="display:none;">
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-blue">
            <div class="stats-icon"><i class="fa fa-shield"></i></div>
            <div class="stats-info"><h4>DDA PRODUCTS</h4><p id="rptDDAProducts">-</p></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-green">
            <div class="stats-icon"><i class="fa fa-arrow-down"></i></div>
            <div class="stats-info"><h4>TOTAL RECEIVED</h4><p id="rptReceived">-</p></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-orange">
            <div class="stats-icon"><i class="fa fa-arrow-up"></i></div>
            <div class="stats-info"><h4>TOTAL DISPENSED</h4><p id="rptDispensed">-</p></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="widget widget-stats bg-purple">
            <div class="stats-icon"><i class="fa fa-balance-scale"></i></div>
            <div class="stats-info"><h4>CLOSING STOCK</h4><p id="rptClosingStock">-</p></div>
        </div>
    </div>
</div>

<!-- Product-wise breakdown -->
<div class="row m-t-20" id="breakdownRow" style="display:none;">
    <div class="col-md-12">
        <div class="panel panel-inverse">
            <div class="panel-heading">
                <h4 class="panel-title" style="color:#fff;"><i class="fa fa-table m-r-5"></i> DDA Product Summary</h4>
            </div>
            <div class="panel-body">
                <table class="table table-striped table-condensed" id="ddaSummaryTable">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Opening Stock</th>
                            <th>Received</th>
                            <th>Dispensed</th>
                            <th>Closing Stock</th>
                            <th>Variance</th>
                        </tr>
                    </thead>
                    <tbody id="ddaSummaryBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script>
        $(document).ready(function () {
            $('.date-picker').datepicker({ autoclose: true, todayHighlight: true, format: 'dd M yyyy' });
        });

        function generateReport() {
            var from = $('#dateFrom').val();
            var to = $('#dateTo').val();
            var url = '/api/dda/report?';
            if (from) url += 'from=' + encodeURIComponent(from) + '&';
            if (to) url += 'to=' + encodeURIComponent(to);

            $.get(url, function (data) {
                $('#summaryRow, #breakdownRow').show();
                $('#rptDDAProducts').text(data.totalDDAProducts || 0);
                $('#rptReceived').text(data.totalReceived || 0);
                $('#rptDispensed').text(data.totalDispensed || 0);
                $('#rptClosingStock').text(data.closingStock || 0);

                var html = '';
                if (data.productSummary && data.productSummary.length) {
                    $.each(data.productSummary, function (i, p) {
                        var vClass = p.variance !== 0 ? 'text-danger font-bold' : '';
                        html += '<tr class="' + vClass + '">';
                        html += '<td>' + p.productName + '</td>';
                        html += '<td>' + p.openingStock + '</td>';
                        html += '<td>' + p.received + '</td>';
                        html += '<td>' + p.dispensed + '</td>';
                        html += '<td>' + p.closingStock + '</td>';
                        html += '<td>' + (p.variance !== 0 ? p.variance : '-') + '</td>';
                        html += '</tr>';
                    });
                } else {
                    html = '<tr><td colspan="6" class="text-center text-muted">No DDA data for this period</td></tr>';
                }
                $('#ddaSummaryBody').html(html);
            });
        }
    </script>
}
