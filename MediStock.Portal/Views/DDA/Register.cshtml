@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-shield"></i> DDA Register <small>Controlled Substances</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("Register", "DDA")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
        </div>
        <h4 class="panel-title">Dangerous Drugs Act (DDA) Register</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-3">
                <label>From</label>
                <input type="text" class="form-control date-picker" id="dateFrom" />
            </div>
            <div class="col-md-3">
                <label>To</label>
                <input type="text" class="form-control date-picker" id="dateTo" />
            </div>
            <div class="col-md-3">
                <label>&nbsp;</label>
                <div>
                    <button class="btn btn-sm btn-primary" onclick="loadRegister();"><i class="fa fa-filter"></i> Filter</button>
                    <button class="btn btn-sm btn-default" onclick="window.print();"><i class="fa fa-print"></i> Print</button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="ddaTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Product</th>
                            <th>Batch No</th>
                            <th>Transaction Type</th>
                            <th>Quantity</th>
                            <th>Balance</th>
                            <th>Patient / Source</th>
                            <th>Doctor / Reference</th>
                            <th>Recorded By</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script>
        var ddaTable;
        $(document).ready(function () {
            $('.date-picker').datepicker({ autoclose: true, format: 'dd M yyyy' });
            loadRegister();
        });

        function loadRegister() {
            var from = $('#dateFrom').val();
            var to = $('#dateTo').val();
            var url = '/api/dda/register?';
            if (from) url += 'from=' + encodeURIComponent(from) + '&';
            if (to) url += 'to=' + encodeURIComponent(to);

            if (ddaTable) ddaTable.destroy();
            ddaTable = $('#ddaTable').DataTable({
                ajax: { url: url, dataSrc: '' },
                columns: [
                    { data: 'transactionDate', render: function (d) { return formatDate(d); } },
                    { data: 'productName' },
                    { data: 'batchNumber' },
                    { data: 'transactionType', render: function (d) {
                        var cls = { 'Sale': 'label-info', 'Received': 'label-success', 'Dispensed': 'label-warning', 'Return': 'label-danger' };
                        return '<span class="label ' + (cls[d] || 'label-default') + '">' + d + '</span>';
                    }},
                    { data: 'quantity' },
                    { data: 'runningBalance' },
                    { data: 'patientOrSource' },
                    { data: 'doctorOrReference' },
                    { data: 'recordedByName' }
                ],
                order: [[0, 'desc']],
                pageLength: 25
            });
        }

        function formatDate(d) { return d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '-'; }
    </script>
}
