@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-shield"></i> DDA Register <small>Controlled Substances</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <button type="button" class="btn btn-xs btn-success" onclick="LoadRegister();"><i class="fa fa-repeat"></i></button>
        </div>
        <h4 class="panel-title">Dangerous Drugs Act (DDA) Register</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-12">
                <button class="btn btn-sm btn-success" data-toggle="modal" data-target="#ddaModal">
                    <i class="fa fa-plus"></i> Record DDA Dispense
                </button>
                <button class="btn btn-sm btn-default" onclick="ExportCsv();"><i class="fa fa-download"></i> Export CSV</button>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="ddaTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Product</th>
                            <th>Type</th>
                            <th>Quantity</th>
                            <th>Balance After</th>
                            <th>Patient</th>
                            <th>Prescriber</th>
                            <th>Reference</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add DDA Entry Modal -->
<div class="modal fade" id="ddaModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                <h4 class="modal-title"><i class="fa fa-shield"></i> Record DDA Dispense</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Product <span class="text-danger">*</span></label>
                    <select class="form-control" id="ddaProductId">
                        <option value="">-- Select Product --</option>
                    </select>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Patient</label>
                            <select class="form-control" id="ddaPatientId">
                                <option value="">-- Walk-in / None --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Dispensed Date</label>
                            <input type="date" class="form-control" id="ddaDate" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label>Quantity <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" id="ddaQuantity" min="1" placeholder="0" />
                </div>
                <div class="form-group">
                    <label>Notes</label>
                    <textarea class="form-control" id="ddaNotes" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="btn btn-success" id="btnSaveDda"><i class="fa fa-save"></i> Save Entry</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        var _ddaTable;
        var ddaAll = [];

        $(document).ready(function () {
            _ddaTable = InitDdaTable();
            LoadRegister();
            LoadDdaProducts();
            LoadDdaPatients();
            $('#ddaDate').val(new Date().toISOString().split('T')[0]);
        });

        function InitDdaTable() {
            return $('#ddaTable').dataTable({
                responsive: true,
                createdRow: function (row, data) { $(row).attr('recid', data.id); },
                aoColumns: [
                    { data: 'created_on',       autoWidth: true, sDefaultContent: '—', render: function (d) { return formatDate(d); } },
                    { data: 'product_name',     autoWidth: true, sDefaultContent: '—' },
                    { data: 'entry_type',       autoWidth: true, sDefaultContent: '—', render: function (d) { return typeLabel(d); } },
                    { data: 'quantity',         autoWidth: true, sDefaultContent: '0' },
                    { data: 'balance_after',    autoWidth: true, sDefaultContent: '—' },
                    { data: 'patient_name',     autoWidth: true, sDefaultContent: '—' },
                    { data: 'prescriber_name',  autoWidth: true, sDefaultContent: '—' },
                    { data: 'reference_number', autoWidth: true, sDefaultContent: '—' },
                    { data: 'notes',            autoWidth: true, sDefaultContent: '—' }
                ],
                order: [[0, 'desc']],
                pageLength: 25
            });
        }

        function LoadRegister() {
            ajaxGet('/DDA/GetRegister', function (data) {
                ddaAll = data || [];
                var t = _ddaTable;
                var s = t.fnSettings();
                t.fnClearTable(true);
                for (var i = 0; i < ddaAll.length; i++) t.oApi._fnAddData(s, ddaAll[i]);
                s.aiDisplay = s.aiDisplayMaster.slice();
                t.fnDraw();
            });
        }

        function LoadDdaProducts() {
            ajaxGet('/Products/GetProducts', function (data) {
                var $sel = $('#ddaProductId');
                var opts = ['<option value="">-- Select Product --</option>'];
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) {
                        var controlled = (data[i].is_controlled_drug == 1 || data[i].is_controlled_drug === true);
                        if (controlled) opts.push('<option value="' + data[i].id + '">' + data[i].name + '</option>');
                    }
                }
                $sel.html(opts.join(''));
            });
        }

        function LoadDdaPatients() {
            ajaxGet('/Clinical/GetPatients', function (data) {
                var $sel = $('#ddaPatientId');
                var opts = ['<option value="0">-- Walk-in / None --</option>'];
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) {
                        opts.push('<option value="' + data[i].id + '">' + data[i].first_name + ' ' + (data[i].last_name || '') + '</option>');
                    }
                }
                $sel.html(opts.join(''));
            });
        }

        function typeLabel(d) {
            if (d === 'Dispense') return '<span class="label label-warning">Dispense</span>';
            if (d === 'Received') return '<span class="label label-success">Received</span>';
            if (d === 'Return') return '<span class="label label-danger">Return</span>';
            if (d === 'Sale') return '<span class="label label-info">Sale</span>';
            return '<span class="label label-default">' + (d || '—') + '</span>';
        }

        function formatDate(d) {
            if (!d) return '—';
            return new Date(d.indexOf('T') > -1 ? d : d + 'T00:00:00').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        }

        $('#btnSaveDda').on('click', function () {
            var productId = parseInt($('#ddaProductId').val()) || 0;
            var patientId = parseInt($('#ddaPatientId').val()) || 0;
            var quantity = parseInt($('#ddaQuantity').val()) || 0;

            if (!productId) { Swal.fire('Validation', 'Select a product.', 'warning'); return; }
            if (quantity <= 0) { Swal.fire('Validation', 'Quantity must be greater than 0.', 'warning'); return; }

            var btn = this;
            btnLoad(btn, 'Saving...');
            ajaxPost('/DDA/AddEntry', {
                product_id: productId,
                patient_id: patientId || null,
                quantity: quantity,
                dispensed_date: $('#ddaDate').val() || null,
                notes: $('#ddaNotes').val().trim() || null
            }, function (res) {
                btnStop(btn);
                if (res.success) {
                    $('#ddaModal').modal('hide');
                    $('#ddaModal input, #ddaModal select, #ddaModal textarea').val('');
                    $('#ddaDate').val(new Date().toISOString().split('T')[0]);
                    LoadRegister();
                    Swal.fire('Saved', res.message, 'success');
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            }, function () { btnStop(btn); Swal.fire('Error', 'Request failed.', 'error'); });
        });

        function ExportCsv() {
            if (!ddaAll.length) { Swal.fire('Info', 'No DDA entries to export.', 'info'); return; }
            var rows = [['Date', 'Product', 'Type', 'Quantity', 'Balance After', 'Patient', 'Prescriber', 'Reference', 'Notes']];
            for (var i = 0; i < ddaAll.length; i++) {
                var e = ddaAll[i];
                rows.push([
                    (e.created_on || ''), e.product_name || '', e.entry_type || '', e.quantity,
                    e.balance_after, e.patient_name || '', e.prescriber_name || '', e.reference_number || '', e.notes || ''
                ]);
            }
            downloadCsv('dda_register.csv', rows);
        }

        function downloadCsv(fileName, rows) {
            var csv = rows.map(function (r) {
                return r.map(function (c) {
                    if (c === null || c === undefined) return '';
                    return '"' + String(c).replace(/"/g, '""') + '"';
                }).join(',');
            }).join('\n');
            var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
}