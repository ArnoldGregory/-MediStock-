@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-prescription-bottle-alt"></i> Prescriptions <small>Clinical</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <button type="button" class="btn btn-xs btn-success" onclick="LoadRx();"><i class="fa fa-repeat"></i></button>
        </div>
        <h4 class="panel-title">Prescriptions</h4>
    </div>
    <div class="panel-body">
        <div class="row m-b-10">
            <div class="col-md-12">
                <button class="btn btn-sm btn-success" data-toggle="modal" data-target="#rxModal">
                    <i class="fa fa-plus"></i> Add Prescription
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="rxTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Rx #</th>
                            <th>Date</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Prescription Modal -->
<div class="modal fade" id="rxModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                <h4 class="modal-title"><i class="fa fa-prescription-bottle-alt"></i> Add Prescription</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Patient <span class="text-danger">*</span></label>
                            <select class="form-control" id="rxPatientId">
                                <option value="">-- Select Patient --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Prescription Date</label>
                            <input type="date" class="form-control" id="rxDate" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Doctor Name</label>
                            <input type="text" class="form-control" id="rxDoctor" placeholder="e.g. Dr. Jane Doe" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Hospital / Clinic</label>
                            <input type="text" class="form-control" id="rxHospital" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label>Notes</label>
                    <textarea class="form-control" id="rxNotes" rows="2"></textarea>
                </div>
                <hr />
                <label>Items <span class="text-danger">*</span></label>
                <table class="table table-bordered table-condensed" id="rxItemsTable">
                    <thead>
                        <tr>
                            <th style="min-width:160px;">Product</th>
                            <th style="min-width:120px;">Medication</th>
                            <th style="width:100px;">Dosage</th>
                            <th style="width:120px;">Frequency</th>
                            <th style="width:100px;">Duration</th>
                            <th style="width:70px;">Qty</th>
                            <th style="width:40px;"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
                <button type="button" class="btn btn-xs btn-info" onclick="AddRxItem();"><i class="fa fa-plus"></i> Add Item</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</button>
                <button type="button" class="btn btn-success" id="btnSaveRx"><i class="fa fa-save"></i> Save Prescription</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        var _rxTable;
        var patientIdFilter = 0;
        var rxItems = [];
        var rxProducts = [];

        $(document).ready(function () {
            var m = location.search.match(/[?&]patientId=(\d+)/);
            if (m) patientIdFilter = parseInt(m[1]);

            _rxTable = InitRxTable();
            LoadRx();
            LoadRxPatients();
            LoadRxProducts();
            $('#rxDate').val(new Date().toISOString().split('T')[0]);
        });

        function InitRxTable() {
            return $('#rxTable').dataTable({
                responsive: true,
                createdRow: function (row, data) { $(row).attr('recid', data.id); },
                aoColumns: [
                    { data: 'prescription_number', autoWidth: true, sDefaultContent: '—' },
                    { data: 'prescription_date',   autoWidth: true, sDefaultContent: '—', render: function (d) { return d ? formatDate(d) : '—'; } },
                    { data: 'patient_name',        autoWidth: true, sDefaultContent: '—' },
                    { data: 'doctor_name',         autoWidth: true, sDefaultContent: '—' },
                    { data: 'status',              autoWidth: true, render: function (d) { return statusLabel(d); } },
                    { bSortable: false, sDefaultContent: '<a href="#" class="btn btn-xs btn-info view-rx"><i class="fa fa-eye"></i></a>' }
                ],
                order: [[1, 'desc']]
            });
        }

        function LoadRx() {
            var url = patientIdFilter ? '/Clinical/GetPrescriptions?patient_id=' + patientIdFilter : '/Clinical/GetPrescriptions';
            ajaxGet(url, function (data) {
                var t = _rxTable;
                var s = t.fnSettings();
                t.fnClearTable(true);
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) t.oApi._fnAddData(s, data[i]);
                }
                s.aiDisplay = s.aiDisplayMaster.slice();
                t.fnDraw();
            });
        }

        function LoadRxPatients() {
            ajaxGet('/Clinical/GetPatients', function (data) {
                var $sel = $('#rxPatientId');
                var opts = ['<option value="">-- Select Patient --</option>'];
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) {
                        opts.push('<option value="' + data[i].id + '">' + data[i].first_name + ' ' + (data[i].last_name || '') + '</option>');
                    }
                }
                $sel.html(opts.join(''));
                if (patientIdFilter) $sel.val(String(patientIdFilter));
            });
        }

        function LoadRxProducts() {
            ajaxGet('/Products/GetProducts', function (data) {
                rxProducts = data || [];
            });
        }

        function AddRxItem() {
            var opts = ['<option value="0">-- Free text --</option>'];
            for (var i = 0; i < rxProducts.length; i++) {
                opts.push('<option value="' + rxProducts[i].id + '">' + rxProducts[i].name + '</option>');
            }
            $('#rxItemsTable tbody').append(
                '<tr>' +
                    '<td><select class="form-control rx-product">' + opts.join('') + '</select></td>' +
                    '<td><input type="text" class="form-control rx-medication" placeholder="Medication name" /></td>' +
                    '<td><input type="text" class="form-control rx-dosage" placeholder="e.g. 500mg" /></td>' +
                    '<td><input type="text" class="form-control rx-frequency" placeholder="e.g. 3x daily" /></td>' +
                    '<td><input type="text" class="form-control rx-duration" placeholder="e.g. 7 days" /></td>' +
                    '<td><input type="number" class="form-control rx-qty" min="1" value="1" /></td>' +
                    '<td><button type="button" class="btn btn-xs btn-danger" onclick="$(this).closest(\'tr\').remove();"><i class="fa fa-trash"></i></button></td>' +
                '</tr>'
            );
        }

        $('#rxItemsTable').on('change', '.rx-product', function () {
            var $row = $(this).closest('tr');
            var pid = parseInt($(this).val()) || 0;
            if (pid) {
                for (var i = 0; i < rxProducts.length; i++) {
                    if (rxProducts[i].id === pid) {
                        $row.find('.rx-medication').val(rxProducts[i].name);
                        break;
                    }
                }
            }
        });

        $('#rxModal').on('hidden.bs.modal', function () {
            $('#rxModal input, #rxModal select, #rxModal textarea').val('');
            $('#rxItemsTable tbody').html('');
            $('#rxDate').val(new Date().toISOString().split('T')[0]);
        });

        $('#btnSaveRx').on('click', function () {
            var patientId = parseInt($('#rxPatientId').val()) || 0;
            if (!patientId) { Swal.fire('Validation', 'Select a patient.', 'warning'); return; }

            var items = [];
            $('#rxItemsTable tbody tr').each(function () {
                var $row = $(this);
                var qty = parseInt($row.find('.rx-qty').val()) || 0;
                if (!$row.find('.rx-product').val() && !$row.find('.rx-medication').val().trim()) return;
                items.push({
                    product_id: parseInt($row.find('.rx-product').val()) || 0,
                    medication_name: $row.find('.rx-medication').val().trim() || 'Medication',
                    dosage: $row.find('.rx-dosage').val().trim() || null,
                    frequency: $row.find('.rx-frequency').val().trim() || null,
                    duration: $row.find('.rx-duration').val().trim() || null,
                    quantity: qty,
                    notes: null
                });
            });
            if (!items.length) { Swal.fire('Validation', 'Add at least one item.', 'warning'); return; }

            var btn = this;
            btnLoad(btn, 'Saving...');
            ajaxPost('/Clinical/AddPrescription', {
                patient_id: patientId,
                doctor_name: $('#rxDoctor').val().trim() || null,
                hospital: $('#rxHospital').val().trim() || null,
                prescription_date: $('#rxDate').val() || null,
                notes: $('#rxNotes').val().trim() || null,
                items: items
            }, function (res) {
                btnStop(btn);
                if (res.success) {
                    $('#rxModal').modal('hide');
                    LoadRx();
                    Swal.fire('Saved', res.message, 'success');
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            }, function () { btnStop(btn); Swal.fire('Error', 'Request failed.', 'error'); });
        });

        $('#rxTable').on('click', 'a.view-rx', function (e) {
            e.preventDefault();
            var d = _rxTable.fnGetData($(this).parents('tr')[0]);
            showRxItems(d);
        });

        function showRxItems(rx) {
            ajaxGet('/Clinical/GetPrescriptionItems?id=' + rx.id, function (data) {
                var rows = [];
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) {
                        rows.push('<tr><td>' + (data[i].medication_name || data[i].product_name || '#') + '</td><td>' + (data[i].dosage || '—') + '</td><td>' + (data[i].frequency || '—') + '</td><td>' + (data[i].duration || '—') + '</td><td>' + data[i].quantity + '</td></tr>');
                    }
                }
                Swal.fire({
                    title: 'Rx ' + (rx.prescription_number || '') + ' — Items',
                    html: '<table class="table table-bordered table-condensed table-striped">' +
                        '<thead><tr><th>Medication</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Qty</th></tr></thead>' +
                        '<tbody>' + (rows.length ? rows.join('') : '<tr><td colspan="5" class="text-center">No items</td></tr>') + '</tbody></table>',
                    width: 650,
                    confirmButtonText: 'Close'
                });
            });
        }

        function statusLabel(d) {
            if (d === 'Dispensed') return '<span class="label label-success">Dispensed</span>';
            if (d === 'Pending') return '<span class="label label-warning">Pending</span>';
            if (d === 'Cancelled') return '<span class="label label-danger">Cancelled</span>';
            return '<span class="label label-default">' + (d || '—') + '</span>';
        }

        function formatDate(d) {
            if (!d) return '—';
            return new Date(d.indexOf('T') > -1 ? d : d + 'T00:00:00').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        }
    </script>
}