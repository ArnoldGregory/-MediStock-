@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-heartbeat"></i> Patient Detail <small>Clinical Records</small></h1>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("Patients", "Clinical")" class="btn btn-xs btn-icon btn-circle btn-primary"><i class="fa fa-arrow-left"></i></a>
        </div>
        <h4 class="panel-title">Patient Information</h4>
    </div>
    <div class="panel-body">
        <div class="row" id="patientInfo">
            <div class="col-md-12">Loading...</div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="panel panel-inverse">
            <div class="panel-heading"><h4 class="panel-title">Allergies</h4></div>
            <div class="panel-body">
                <table class="table table-striped table-bordered table-condensed" id="allergiesTable">
                    <thead><tr><th>Allergen</th><th>Severity</th><th>Notes</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-inverse">
            <div class="panel-heading"><h4 class="panel-title">Conditions</h4></div>
            <div class="panel-body">
                <table class="table table-striped table-bordered table-condensed" id="conditionsTable">
                    <thead><tr><th>Condition</th><th>Diagnosed</th><th>Notes</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("Prescriptions", "Clinical")" class="btn btn-xs btn-success"><i class="fa fa-plus"></i> New Rx</a>
        </div>
        <h4 class="panel-title">Prescription History</h4>
    </div>
    <div class="panel-body">
        <table id="ptRxTable" class="table table-striped table-hover table-bordered table-condensed">
            <thead>
                <tr>
                    <th>Rx #</th>
                    <th>Date</th>
                    <th>Doctor</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        var patientId = @ViewBag.PatientId;
        var _rxTable;

        $(document).ready(function () {
            _rxTable = InitRxTable();
            LoadPatient();
            LoadAllergies();
            LoadConditions();
            LoadRx();
        });

        function LoadPatient() {
            ajaxGet('/Clinical/GetPatient?id=' + patientId, function (data) {
                if (!data || data.length === 0) { $('#patientInfo').html('<div class="col-md-12">Patient not found.</div>'); return; }
                var p = data[0];
                $('#patientInfo').html(
                    '<div class="col-md-3"><strong>Name:</strong> ' + (p.first_name || '') + ' ' + (p.last_name || '') + '</div>' +
                    '<div class="col-md-2"><strong>Gender:</strong> ' + (p.gender || '—') + '</div>' +
                    '<div class="col-md-2"><strong>DOB:</strong> ' + (p.date_of_birth ? formatDate(p.date_of_birth) : '—') + '</div>' +
                    '<div class="col-md-2"><strong>Phone:</strong> ' + (p.phone || '—') + '</div>' +
                    '<div class="col-md-3"><strong>Email:</strong> ' + (p.email || '—') + '</div>' +
                    '<div class="col-md-3"><strong>NHIF:</strong> ' + (p.nhif_number || '—') + '</div>' +
                    '<div class="col-md-3"><strong>Address:</strong> ' + (p.address || '—') + '</div>' +
                    '<div class="col-md-6"><strong>Allergies:</strong> ' + (p.allergies || 'NKDA') + '</div>' +
                    '<div class="col-md-12 m-t-5"><strong>Medical History:</strong> ' + (p.medical_history || '—') + '</div>'
                );
            });
        }

        function LoadAllergies() {
            ajaxGet('/Clinical/GetPatientAllergies?id=' + patientId, function (data) {
                var rows = [];
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) {
                        rows.push('<tr><td>' + (data[i].allergen || '—') + '</td><td>' + (data[i].severity || '—') + '</td><td>' + (data[i].notes || '—') + '</td></tr>');
                    }
                }
                $('#allergiesTable tbody').html(rows.length ? rows.join('') : '<tr><td colspan="3" class="text-center">None recorded</td></tr>');
            });
        }

        function LoadConditions() {
            ajaxGet('/Clinical/GetPatientConditions?id=' + patientId, function (data) {
                var rows = [];
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) {
                        rows.push('<tr><td>' + (data[i].condition_name || '—') + '</td><td>' + (data[i].diagnosed_date ? formatDate(data[i].diagnosed_date) : '—') + '</td><td>' + (data[i].notes || '—') + '</td></tr>');
                    }
                }
                $('#conditionsTable tbody').html(rows.length ? rows.join('') : '<tr><td colspan="3" class="text-center">None recorded</td></tr>');
            });
        }

        function InitRxTable() {
            return $('#ptRxTable').dataTable({
                responsive: true,
                createdRow: function (row, data) { $(row).attr('recid', data.id); },
                aoColumns: [
                    { data: 'prescription_number', autoWidth: true, sDefaultContent: '—' },
                    { data: 'prescription_date',   autoWidth: true, sDefaultContent: '—', render: function (d) { return d ? formatDate(d) : '—'; } },
                    { data: 'doctor_name',         autoWidth: true, sDefaultContent: '—' },
                    { data: 'status',              autoWidth: true, render: function (d) { return statusLabel(d); } },
                    { bSortable: false, sDefaultContent: '<a href="#" class="btn btn-xs btn-info view-rx"><i class="fa fa-eye"></i></a>' }
                ],
                order: [[1, 'desc']]
            });
        }

        function LoadRx() {
            ajaxGet('/Clinical/GetPrescriptions?patient_id=' + patientId, function (data) {
                var t = _rxTable;
                var s = t.fnSettings();
                t.fnClearTable(true);
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) t.oApi._fnAddData(s, data[i]);
                }
                s.aiDisplay = s.aiDisplayMaster.slice();
                t.fnDraw();
            });
        }

        $('#ptRxTable').on('click', 'a.view-rx', function (e) {
            e.preventDefault();
            var d = _rxTable.fnGetData($(this).parents('tr')[0]);
            showRxItems(d);
        });

        function showRxItems(rx) {
            ajaxGet('/Clinical/GetPrescriptionItems?id=' + rx.id, function (data) {
                var rows = [];
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) {
                        rows.push('<tr><td>' + (data[i].medication_name || data[i].product_name || '#') + '</td><td>' + (data[i].dosage || '—') + '</td><td>' + (data[i].frequency || '—') + '</td><td>' + (data[i].duration || '—') + '</td><td>' + data[i].quantity + '</td></tr>');
                    }
                }
                Swal.fire({
                    title: 'Rx ' + (rx.prescription_number || '') + ' — Items',
                    html: '<table class="table table-bordered table-condensed table-striped">' +
                        '<thead><tr><th>Medication</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Qty</th></tr></thead>' +
                        '<tbody>' + (rows.length ? rows.join('') : '<tr><td colspan="5" class="text-center">No items</td></tr>') + '</tbody></table>',
                    width: 650,
                    confirmButtonText: 'Close'
                });
            });
        }

        function statusLabel(d) {
            if (d === 'Dispensed') return '<span class="label label-success">Dispensed</span>';
            if (d === 'Pending') return '<span class="label label-warning">Pending</span>';
            if (d === 'Cancelled') return '<span class="label label-danger">Cancelled</span>';
            return '<span class="label label-default">' + (d || '—') + '</span>';
        }

        function formatDate(d) {
            if (!d) return '—';
            return new Date(d.indexOf('T') > -1 ? d : d + 'T00:00:00').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        }
    </script>
}