@section PageStyles {
    <link href="~/assets/static/plugins/DataTables/media/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/DataTables/extensions/Responsive/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<h1 class="page-header"><i class="fa fa-pills"></i> Products <small>Register</small></h1>

<div class="panel panel-inverse" id="main_panel">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("Index","Products")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
            <a href="@Url.Action("Index","Dashboard")" class="btn btn-xs btn-icon btn-circle btn-danger" data-click="panel-remove"><i class="fa fa-times"></i></a>
        </div>
        <h4 class="panel-title">Product Register</h4>
    </div>
    <div class="panel-body">

        <div class="row m-b-10">
            <div class="col-md-12">
                <a href="#" class="btn btn-sm btn-success" data-toggle="modal" data-target="#product-modal">
                    <i class="fa fa-plus"></i> Add Product
                </a>
                <a href="/Suppliers/ImportInvoice" class="btn btn-sm btn-info">
                    <i class="fa fa-file-pdf-o"></i> Import Supplier Invoice
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="productsTable" class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Code (SKU)</th>
                            <th>Category</th>
                            <th>Selling Price</th>
                            <th>Cost Price</th>
                            <th>Stock</th>
                            <th>Reorder</th>
                            <th>DDA</th>
                            <th>Status</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- ADD / EDIT MODAL -->
        <div class="modal fade" id="product-modal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <form id="productForm">
                        <input type="hidden" id="productId" value="" />
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal"><i class="fa fa-times-circle"></i></button>
                            <h4 class="modal-title" id="productModalLabel"><i class="fa fa-pills"></i> Add Product</h4>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-8">
                                    <div class="form-group">
                                        <label>Product Name <span class="text-danger">*</span></label>
                                        <input id="productName" type="text" class="form-control" placeholder="e.g. Amoxicillin 500mg" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Code (SKU)</label>
                                        <input id="productSku" type="text" class="form-control" placeholder="e.g. AMOX-500" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Category <span class="text-danger">*</span></label>
                                        <select id="categoryId" class="form-control">
                                            <option value="">-- Select --</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Unit of Measure</label>
                                        <input id="unitOfMeasure" type="text" class="form-control" placeholder="e.g. strips, bottles" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>DDA Controlled?</label>
                                        <select id="isDDA" class="form-control">
                                            <option value="false">No</option>
                                            <option value="true">Yes — DDA Register Required</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Selling Price <span class="text-danger">*</span></label>
                                        <input id="sellingPrice" type="number" class="form-control" step="0.01" min="0" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Cost Price</label>
                                        <input id="costPrice" type="number" class="form-control" step="0.01" min="0" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Reorder Level</label>
                                        <input id="reorderLevel" type="number" class="form-control" value="10" min="0" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Barcode</label>
                                <input id="productBarcode" type="text" class="form-control" placeholder="Optional barcode" />
                            </div>
                            <div class="form-group">
                                <label>Description</label>
                                <textarea id="productDescription" rows="3" class="form-control" placeholder="Optional description"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <a href="#" class="btn btn-white btn-sm" data-dismiss="modal"><i class="fa fa-times"></i> Cancel</a>
                            <a href="#" class="btn btn-success btn-sm" id="btnSaveProduct"><i class="fa fa-save"></i> Save Product</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <hr />
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/DataTables/media/js/jquery.dataTables.js"></script>
    <script src="~/assets/static/plugins/DataTables/media/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/static/plugins/DataTables/extensions/Responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/static/plugins/bootstrap-sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/assets/static/js/products.js"></script>
}
